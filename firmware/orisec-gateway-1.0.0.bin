const FONT5={};
F5D.split(';').forEach(s=>{ const p=s.split(','); FONT5[+p[0]]={ w:+p[1], b:p[2], h:7 }; });
// Hebrew glyphs (Font2): the panel sends ASCII a-z ('{') with Font2 active and the
