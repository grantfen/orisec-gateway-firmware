const HEBFONT={97:{w:6,h:8,b:'000000100001010001001010010100100010100001000000'},98:{w:6,h:8,b:'000000111110000010000010000010000010111111000000'},99:{w:4,h:8,b:'00000110000100010011010110010000'},100:{w:5,h:8,b:'0000011111000100001000010000100001000000'},101:{w:5,h:8,b:'0000011111000010000110001100011000100000'},102:{w:2,h:8,b:'0011010101010100'},103:{w:3,h:8,b:'000111010010100010001000'},104:{w:5,h:8,b:'0000011111100011000110001100011000100000'},105:{w:5,h:8,b:'0000010011101011010110001100011111100000'},106:{w:2,h:8,b:'0011010000000000'},107:{w:4,h:8,b:'00001110000100010001000111100000'},108:{w:4,h:8,b:'00001111000100010001000100010001'},109:{w:5,h:8,b:'0000011111100011000110001100011111100000'},110:{w:4,h:8,b:'10001111000100010001000101100000'},111:{w:5,h:8,b:'0000010111010011000110001100011001100000'},112:{w:3,h:8,b:'000011001001001001111000'},113:{w:2,h:8,b:'0011010101010101'},114:{w:5,h:8,b:'0000011111100011000110001100010111000000'},115:{w:5,h:8,b:'0000010001100010100100101000111111100000'},116:{w:5,h:8,b:'0000011111100011110100001000011111100000'},117:{w:4,h:8,b:'00001111100111010001000100010001'},118:{w:5,h:8,b:'0000010011011000010000010000010000100001'},119:{w:5,h:8,b:'0000010001010100010000010000011111100000'},120:{w:5,h:8,b:'0000010101101011010110101101010101000000'},121:{w:5,h:8,b:'0000011111000010000100001000010000100000'},122:{w:5,h:8,b:'0000001111010010100101001010011100100000'},123:{w:5,h:8,b:'0000011111000011000110001100101000010000'}};
const PXW=4, PXH=4, GW=128, GH=32, LINE_H=8, GTOP=0, SPACE_W=4, GAP=0;
const C_LIGHT='#d7e6ff', C_DARK='#1340c4';
// Advance (panel-columns) for a character. In tiny/Font3 mode digit/letter glyphs
// pack tight (w+1), the '|' cell separators and spaces are 1px-narrow, and any
// char missing from the tiny font falls back to the full-size font.
function gW(ch,f){ const cc=ch.charCodeAt(0); if(cc===57506)return 6; if(ANIM[cc])return ANIM[cc][0].w+1; if(f===3){ if(ch==='|'||ch===' ')return 1; const g=TINYFONT[cc]; if(g)return g.w+1; const n=FONT[cc]; return (n?n.w:SPACE_W)+1; } if(f===1){ const g=FONT5[cc]; if(g)return g.w+1; if(cc>=32&&cc<=126)return 6; const n=FONT[cc]; return (n?n.w:SPACE_W)+1; } if(f===2){ const g=HEBFONT[cc]; if(g)return g.w+1; const n=FONT[cc]; return (n?n.w:SPACE_W)+1; } const g=FONT[cc]; return (g?g.w:SPACE_W)+1; }
function runsWidth(runs){ let w=0; (runs||[]).forEach(run=>{ const t=run[2]; for(const ch of run[0]) w+=gW(ch,t); }); return w; }
function drawGlyph(ctx,g,gx,gy,color){ ctx.fillStyle=color; const h=g.h||8; for(let r=0;r<h;r++){ for(let c=0;c<g.w;c++){ if(g.b[r*g.w+c]==='1') ctx.fillRect((gx+c)*PXW,(gy+r)*PXH,PXW-GAP,PXH); } } }
// Inline GData bitmap: hex column bytes, each an 8-row vertical strip (LSB=top).
function drawGfx(ctx,hex,gx,gy,rinv,fi){ const w=hex.length>>1, inv=fi||rinv, col=inv?C_DARK:C_LIGHT; if(rinv&&!fi){ ctx.fillStyle=C_LIGHT; ctx.fillRect(gx*PXW,gy*PXH,w*PXW,8*PXH); } ctx.fillStyle=col; for(let c=0;c<w;c++){ const b=parseInt(hex.substr(c*2,2),16); for(let r=0;r<8;r++){ if((b>>r)&1) ctx.fillRect((gx+c)*PXW,(gy+r)*PXH,PXW-GAP,PXH); } } }
function drawRuns(ctx,runs,gx,gy,fi){ (runs||[]).forEach(run=>{ const inv=fi||run[1], t=run[2]; for(const ch of run[0]){ const aw=gW(ch,t); const col=inv?C_DARK:C_LIGHT; if(inv&&!fi){ ctx.fillStyle=C_LIGHT; ctx.fillRect(gx*PXW,gy*PXH,aw*PXW,8*PXH); } if(t===3){ const cc=ch.charCodeAt(0); if(ch==='|'){ ctx.fillStyle=col; ctx.fillRect(gx*PXW,gy*PXH,PXW-GAP,7*PXH); } else if(ch!==' '){ const g=TINYFONT[cc]||FONT[cc]; if(g) drawGlyph(ctx,g,gx,(g.h||8)===5?gy+1:gy,col); } } else if(t===1){ const cc3=ch.charCodeAt(0); const g=FONT5[cc3]||FONT[cc3]; if(g) drawGlyph(ctx,g,gx,gy,col); } else if(t===2){ const cc4=ch.charCodeAt(0); const g=HEBFONT[cc4]||FONT[cc4]; if(g) drawGlyph(ctx,g,gx,gy,col); } else { const cc2=ch.charCodeAt(0); const g=animGlyph(cc2)||FONT[cc2]; if(g) drawGlyph(ctx,g,gx,gy,col); } gx+=aw; } }); return gx; }
// ShowProgress (0x0E): outlined bar from x0, width=maxSize clamped to the display
// right edge, filled value/maxLevel from the left. The 3-digit percentage (000-100,
// no % sign) sits just past the fill if it fits, else at the end of the fill inverted.
function drawProgress(ctx,x0,gy,pb,fi){ const sz=pb[0],lv=pb[1],vl=pb[2]; const x1=Math.min(x0+sz,GW), w=x1-x0; if(w<4) return; const rows=7, y0=gy; const on=fi?C_DARK:C_LIGHT, off=fi?C_LIGHT:C_DARK; ctx.fillStyle=on; ctx.fillRect(x0*PXW,y0*PXH,w*PXW,PXH-GAP); ctx.fillRect(x0*PXW,(y0+rows-1)*PXH,w*PXW,PXH-GAP); ctx.fillRect(x0*PXW,y0*PXH,PXW-GAP,rows*PXH); ctx.fillRect((x1-1)*PXW,y0*PXH,PXW-GAP,rows*PXH); const frac=lv>0?Math.min(1,Math.max(0,vl/lv)):0; const ix=x0+1, iw=w-2, fw=Math.round(iw*frac); ctx.fillRect(ix*PXW,(y0+1)*PXH,fw*PXW,(rows-2)*PXH); const pct=String(Math.round(frac*100)).padStart(3,'0'); let tw=0; for(const ch of pct) tw+=gW(ch,3); const fe=ix+fw, br=x1-1; let tx,color; if(fe+tw<=br){ tx=fe+1; color=on; } else { tx=Math.max(ix,fe-tw); color=off; } let cx=tx; for(const ch of pct){ const g=TINYFONT[ch.charCodeAt(0)]; if(g) drawGlyph(ctx,g,cx,gy+1,color); cx+=gW(ch,3); } }
// Animated panel avi icons (aviChars 0xF0-0xFC in graphicFonts.h), keyed by
// Private-Use codepoint U+E000+code. Frames decoded column-major (LSB=top)
// straight from the ROM _xxxAvi[][] arrays; advanced once per LCD poll (~1Hz).
const ANIM={
 57584:[{w:5,h:8,b:'0101001010111111111111111011100010000000'},{w:5,h:8,b:'0000000000000000000000000000000000000000'}],
 57585:[{w:4,h:8,b:'01101111100110011001100111110000'},{w:4,h:8,b:'01101111100110011001111111110000'},{w:4,h:8,b:'01101111100110011111111111110000'},{w:4,h:8,b:'01101111100111111111111111110000'},{w:4,h:8,b:'01101111111111111111111111110000'}],
 57586:[{w:4,h:8,b:'01101111111111111111111111110000'},{w:4,h:8,b:'00000000000000000000000000000000'}],
 57587:[{w:7,h:8,b:'00000000000000000000000000000001000001010000010000000000'},{w:7,h:8,b:'00000000000000001110001000100001000001010000010000000000'},{w:7,h:8,b:'01111101000001001110001000100001000001010000010000000000'}],
 57588:[{w:7,h:8,b:'00000000000000000000000000000000000000000010101010000000'},{w:7,h:8,b:'00000000000000000000000000000010000001000010101010000000'},{w:7,h:8,b:'00000000000000000010000001000010100001010010101010000000'},{w:7,h:8,b:'00000010000001000010100001010010101001010110101010000000'}],
 57589:[{w:5,h:8,b:'0000000100100010000010001001000000000000'},{w:5,h:8,b:'0000001010000001000100000010100000000000'}],
 57590:[{w:5,h:8,b:'0111010001100011000101110011100010000000'},{w:5,h:8,b:'0111011111111111111101110011100010000000'}],
 57591:[{w:7,h:8,b:'00011110011111011011011000001110000111000011000000000000'},{w:7,h:8,b:'00000000000000000000000000000000000000000000000000000000'}],
 57592:[{w:7,h:8,b:'00000001111111011111010111011101011111011111111110000000'},{w:7,h:8,b:'00000000000000000000000000000000000000000000000000000000'}],
 57593:[{w:6,h:8,b:'000000000000000000111111000000110000110000000000'},{w:6,h:8,b:'001100001100000000111111000000000000000000000000'},{w:6,h:8,b:'000000000000000000111111000000000011000011000000'}],
 57594:[{w:5,h:8,b:'1111110001101011010110001100011111000000'},{w:5,h:8,b:'0000000000000000000000000000000000000000'}],
 57595:[{w:5,h:8,b:'0000001110100011010110001011100000000000'},{w:5,h:8,b:'0000001110100011000110001011100000000000'}],
 57596:[{w:5,h:8,b:'0111011111011100010000000000000000000000'},{w:5,h:8,b:'0111001110111110111000100000000000000000'},{w:5,h:8,b:'0111001110011101111101110001000000000000'},{w:5,h:8,b:'0111001110011100111011111011100010000000'}]
};
function animGlyph(cc){ const a=ANIM[cc]; return a?a[animTick%a.length]:null; }
let animTick=0;
async function updateLCD(){
  try{
    const r=await authFetch('/keypad/lcd'); const d=await r.json();
    if(!d.ok) return;
    animTick=(animTick+1)|0;
    const rawEl=document.getElementById('lcd-raw'); if(rawEl) rawEl.textContent='raw: '+(d.raw||'');
    const cv=document.getElementById('lcd-canvas'); if(!cv) return; const ctx=cv.getContext('2d');
    ctx.clearRect(0,0,cv.width,cv.height);
    const lines=d.lines||[];
    const nw=new Date(), p2=n=>String(n).padStart(2,'0');
    const tStr=p2(nw.getHours())+':'+p2(nw.getMinutes())+'.'+p2(nw.getSeconds());
    const dStr=p2(nw.getDate())+'/'+p2(nw.getMonth()+1)+'/'+nw.getFullYear();
    lines.forEach(ln=>['l','r'].forEach(g=>(ln[g]||[]).forEach(run=>{ run[0]=run[0].split('\uE000').join(tStr).split('\uE001').join(dStr); })));
    let savedCol=0;  // Align (0x10) cursor save/restore: set when a line has sa>0, used by col -4
    for(let i=0;i<4;i++){
      const ln=lines[i]||{c:false,l:[],r:[]}; const gy=i*LINE_H+GTOP; const fi=!!ln.il;
      if(ln.sa>0){ let sw=0,sc=0; (ln.l||[]).forEach(run=>{ const t=run[2]; for(const ch of run[0]){ if(sc<ln.sa){ sw+=gW(ch,t); sc++; } } }); savedCol=sw; }  // remember cursor col after sa chars
      if(fi){ ctx.fillStyle=C_LIGHT; ctx.fillRect(0,gy*PXH,GW*PXW,8*PXH); }
      if(ln.c){ const w=runsWidth(ln.l); drawRuns(ctx,ln.l,Math.max(0,Math.floor((GW-w)/2)),gy,fi); }
      else { const le=drawRuns(ctx,ln.l,0,gy,fi); let gxr=le; (ln.r||[]).forEach(run=>{ const c=run[3]; if(c===-1){ const w=runsWidth([run]); gxr=Math.max(0,GW-w); } else if(c===-3){ const w=runsWidth([run]); gxr=Math.max(0,Math.floor((GW-w)/2)); } else if(c===-4){ gxr=savedCol; } else if(c>=0){ const rw=runsWidth([run]); let st=Math.max(c,gxr); if(st+rw>GW) st=Math.max(gxr,GW-rw); gxr=Math.max(0,st); } gxr=drawRuns(ctx,[run],gxr,gy,fi); }); if(ln.pb) drawProgress(ctx,gxr,gy,ln.pb,fi); }
      const gEnd=runsWidth(ln.l); (ln.g||[]).forEach(gg=>{ const c=gg[0], w=gg[2].length>>1; let x; if(c===-1)x=Math.max(0,GW-w); else if(c===-3)x=Math.max(0,Math.floor((GW-w)/2)); else if(c===-4)x=savedCol; else if(c>=0)x=Math.min(c,Math.max(0,GW-w)); else x=gEnd; drawGfx(ctx,gg[2],x,gy,gg[1],fi); });
    }
    // Mains-plug status icon (not a panel glyph): top-left, only when AC is
    // present and line-1 left is empty (the panel's idle/clock screen).
    const l0=lines[0]||{l:[]}; const l0empty=!(l0.l||[]).some(r=>r[0]&&r[0].replace(/\s/g,''));
    if(d.ac && l0empty){ const pg=FONT[57516]; if(pg) drawGlyph(ctx,pg,0,GTOP,C_LIGHT); }
    // Dot-matrix: carve a thin, soft gap on every panel-pixel boundary so each lit
    // pixel reads as a separate dot against the LCD substrate (like the real panel).
    ctx.globalCompositeOperation='destination-out'; ctx.fillStyle='rgba(0,0,0,0.38)';
    for(let x=PXW;x<cv.width;x+=PXW) ctx.fillRect(x-0.5,0,1,cv.height);
    for(let y=PXH;y<cv.height;y+=PXH) ctx.fillRect(0,y-0.5,cv.width,1);
    ctx.globalCompositeOperation='source-over';
  }catch(e){ console.error('LCD update error:',e); }
}

async function refreshStatus() {
  try {
    const r = await authFetch('/healthz');
    const d = await r.json();
    const cb = document.getElementById('conn-badge');
    if (d.panel_online) { cb.textContent = 'CONNECTED'; cb.className = 'status-badge badge-connected'; }
    else { cb.textContent = 'DISCONNECTED'; cb.className = 'status-badge badge-disconnected'; }
  } catch (e) {}
  try {
    const r = await authFetch('/api/system/power');
    const d = await r.json();
    if (d.ok) {
      const ac = document.getElementById('ac-badge');
      const bt = document.getElementById('batt-badge');
      if (d.psu_ac_fail) { ac.textContent = 'AC: FAIL'; ac.className = 'status-badge badge-ac-fail'; }
      else { ac.textContent = 'AC: OK'; ac.className = 'status-badge badge-ac-ok'; }
      if (d.psu_battery_fail) { bt.textContent = 'BATT: FAIL'; bt.className = 'status-badge badge-batt-fail'; }
      else { bt.textContent = 'BATT: OK'; bt.className = 'status-badge badge-batt-ok'; }
    }
  } catch (e) {}
  document.getElementById('time-badge').textContent = 'Last Update: ' + new Date().toLocaleTimeString();
}

async function logout() {
  await authFetch('/api/logout', { method: 'POST' }).catch(() => {});
  localStorage.clear();
  window.location.href = '/ui/login';
}

let lcdTimer = null, statusTimer = null;
window.addEventListener('load', () => {
  updateLCD(); refreshStatus();
  lcdTimer = setInterval(updateLCD, 1000);
  statusTimer = setInterval(refreshStatus, 5000);
});
window.addEventListener('unload', () => {
  if (lcdTimer) clearInterval(lcdTimer);
  if (statusTimer) clearInterval(statusTimer);
});
</script>
</div>
</div>
<script src="/ui/theme.js"></script>
</body>
</html>
␀␀␀␀<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orisec Gateway - Outputs</title>
<link rel="stylesheet" href="/ui/theme.css">
</head>
<body>
<div class="app-shell">
<aside class="sidebar">
<div class="app-brand"><div class="brand-mark">O</div><div><div class="brand-name">ORISEC</div><div class="brand-sub">Gateway</div></div></div>
<nav class="sidebar-nav">
<a href="/ui/zones"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1.3"/><rect x="14" y="3" width="7" height="7" rx="1.3"/><rect x="3" y="14" width="7" height="7" rx="1.3"/><rect x="14" y="14" width="7" height="7" rx="1.3"/></svg><span>Zones</span></a>
<a href="/ui/areas"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="5" rx="1.3"/><rect x="3" y="15" width="18" height="5" rx="1.3"/></svg><span>Partitions</span></a>
<a href="/ui/keypad"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="6" cy="6" r="1.9"/><circle cx="12" cy="6" r="1.9"/><circle cx="18" cy="6" r="1.9"/><circle cx="6" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="18" cy="12" r="1.9"/><circle cx="6" cy="18" r="1.9"/><circle cx="12" cy="18" r="1.9"/><circle cx="18" cy="18" r="1.9"/></svg><span>Keypad</span></a>
<a href="/ui/outputs" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3v9"/><path d="M6.5 7a8 8 0 1 0 11 0"/></svg><span>Outputs</span></a>
<a href="/ui/system-flags"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 5 15L17 12h4"/></svg><span>System</span></a>
<a href="/ui/settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><line x1="4" y1="8" x2="20" y2="8"/><circle cx="9" cy="8" r="2.4" fill="currentColor" stroke="none"/><line x1="4" y1="16" x2="20" y2="16"/><circle cx="15" cy="16" r="2.4" fill="currentColor" stroke="none"/></svg><span>Settings</span></a>
</nav>
<a href="#" class="sidebar-logout" onclick="if(typeof logout===&quot;function&quot;){logout();}else{location.href=&quot;/ui/login&quot;;}return false;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3"/><path d="M10 8l-4 4 4 4"/><path d="M6 12h9"/></svg><span>Logout</span></a>
</aside>
<div class="sidebar-scrim"></div>
<div class="app-main">
<div class="header">
<h1>ORISEC GATEWAY - OUTPUTS</h1>
<div class="nav">
<a href="/ui/zones">Zones</a> | <a href="/ui/areas">Partitions</a> | <a href="/ui/keypad">Keypad</a> | <a href="/ui/outputs">Outputs</a> | <a href="/ui/system-flags">System Flags</a> | <a href="/ui/settings">Settings</a> | <a href="#" onclick="logout(); return false;" style="color:#ff6b6b;">Logout</a>
</div>
<div class="status-bar">
<span class="status-badge badge-disconnected" id="conn-badge">DISCONNECTED</span>
<span class="status-badge badge-info" id="count-badge">Outputs: --</span>
<span class="status-badge badge-info" id="time-badge">Last Update: --</span>
</div>
</div>
<div class="container">
<div class="partitions-grid" id="outputs-grid"></div>
</div>
<script>
const token = localStorage.getItem('auth_token');
if (!token) window.location.href = '/ui/login';

async function authFetch(url, options = {}) {
  options.headers = options.headers || {};
  options.headers['Authorization'] = 'Bearer ' + token;
  const r = await fetch(url, options);
  if (r.status === 401) { localStorage.clear(); window.location.href = '/ui/login'; throw new Error('Session expired'); }
  return r;
}

let outputsData = [];

async function init() {
  await refreshStatus();
  await refresh();
  setInterval(refresh, 1500);
  setInterval(refreshStatus, 15000);
}

async function refreshStatus() {
  try {
    const r = await authFetch('/healthz');
    const d = await r.json();
    const cb = document.getElementById('conn-badge');
    if (d.panel_online) { cb.textContent = 'CONNECTED'; cb.className = 'status-badge badge-connected'; }
    else { cb.textContent = 'DISCONNECTED'; cb.className = 'status-badge badge-disconnected'; }
  } catch(e) {}
}

async function refresh() {
  try {
    const r = await authFetch('/api/outputs');
    const d = await r.json();
    outputsData = d.outputs || [];
    document.getElementById('count-badge').textContent = 'Outputs: ' + (d.count || 0);
    document.getElementById('time-badge').textContent = 'Last Update: ' + new Date().toLocaleTimeString();
    renderGrid();
  } catch(e) { console.error('Refresh failed', e); }
}

function renderGrid() {
  const grid = document.getElementById('outputs-grid');
  grid.innerHTML = '';
  if (!outputsData.length) {
    const m = document.createElement('div');
    m.className = 'state-loading';
    m.textContent = 'No outputs configured on this panel.';
    grid.appendChild(m);
    return;
  }
  outputsData.forEach(o => {
    const on = !!o.on;
    const card = document.createElement('div');
    card.className = 'part-card' + (on ? ' out-on' : '');
    const numEl = document.createElement('div');
    numEl.className = 'part-num';
    numEl.textContent = 'O' + String(o.id).padStart(2,'0');
    const nameEl = document.createElement('div');
    nameEl.className = 'part-name';
    nameEl.textContent = o.name || ('Output ' + o.id);
    const stateEl = document.createElement('div');
    stateEl.className = 'part-state';
    stateEl.textContent = on ? 'ON' : 'OFF';
    const btn = document.createElement('button');
    btn.className = 'btn ' + (on ? 'btn-arm' : 'btn-disarm');
    btn.textContent = on ? 'Turn Off' : 'Turn On';
    btn.onclick = () => toggle(o.id, !on);
    card.appendChild(numEl); card.appendChild(nameEl); card.appendChild(stateEl); card.appendChild(btn);
    grid.appendChild(card);
  });
}

async function toggle(id, on) {
  try {
    const r = await authFetch('/api/outputs/set?num=' + id + '&state=' + (on ? 1 : 0), { method: 'POST' });
    const d = await r.json();
    if (!d.ok) alert(d.error || 'Command failed');
  } catch(e) {
    alert('Failed: ' + e.message);
  }
  setTimeout(refresh, 300);
}

async function logout() {
  await authFetch('/api/logout', { method: 'POST' }).catch(() => {});
  localStorage.clear();
  window.location.href = '/ui/login';
}

init();
</script>
</div>
</div>
<script src="/ui/theme.js"></script>
</body>
</html>
