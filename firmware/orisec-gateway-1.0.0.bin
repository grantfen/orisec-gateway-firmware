/* Orisec Gateway â€” theme + controls helper (served at /ui/theme.js).
   The sidebar + .app-main shell is baked into each page's HTML. This script only:
     - applies the saved light/dark choice (falls back to the OS setting);
     - adds the light/dark toggle button into the topbar (or page, on login);
     - adds the mobile hamburger and wires the sidebar drawer.
   No page data logic is touched. */
(function () {
  var root = document.documentElement;
  try { var saved = localStorage.getItem('ui_theme'); if (saved) root.setAttribute('data-theme', saved); } catch (e) {}

  function osLight() { return window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches; }
  function current() { return root.getAttribute('data-theme') || (osLight() ? 'light' : 'dark'); }

  function ready(fn) { if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn); }

  ready(function () {
    // Light/dark toggle
    var toggle = document.createElement('button');
    toggle.className = 'theme-toggle'; toggle.type = 'button'; toggle.title = 'Toggle light / dark';
    function label() { toggle.textContent = current() === 'dark' ? 'Light' : 'Dark'; }
    label();
    toggle.addEventListener('click', function () {
      var next = current() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('ui_theme', next); } catch (e) {}
      label();
    });

    var header = document.querySelector('.app-shell .header');
    var sidebar = document.querySelector('.app-shell .sidebar');
    var scrim = document.querySelector('.app-shell .sidebar-scrim');

    if (header && sidebar) {
      // Mobile hamburger + drawer
      var ham = document.createElement('button');
      ham.className = 'app-hamburger'; ham.type = 'button'; ham.title = 'Menu';
      ham.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>';
      function open(o) { sidebar.classList.toggle('open', o); if (scrim) scrim.classList.toggle('open', o); }
      ham.addEventListener('click', function () { open(!sidebar.classList.contains('open')); });
      if (scrim) scrim.addEventListener('click', function () { open(false); });
      sidebar.addEventListener('click', function (e) { if (e.target.closest('a')) open(false); });
      header.insertBefore(ham, header.firstChild);
      header.appendChild(toggle);
    } else {
      document.body.appendChild(toggle);   // login page (no shell)
    }
  });
})();
␀
/* ============================================================================
   Orisec Gateway â€” shared UI theme
   Drop-in restyle for the embedded web UI. Uses the SAME class names the
   existing pages/JS already emit, so no JavaScript changes are required.
   Dark by default; light theme auto-applies via prefers-color-scheme.
   Served once at /ui/theme.css and <link>-ed from every page.
   ========================================================================== */

:root {
  --font: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --mono: "IBM Plex Mono", "SF Mono", "Cascadia Mono", Consolas, monospace;

  --bg: #0b0f17;
  --surface: #131a26;
  --surface2: #1a2333;
  --surface3: #212c3f;
  --border: #26324a;
  --border-soft: #1e293b;
  --text: #e6ecf4;
  --dim: #93a1b5;
  --faint: #5d6b80;

  --accent: #3d7fe0;
  --accent-text: #ffffff;
  --accent-soft: rgba(61,127,224,.15);
  --accent-border: rgba(61,127,224,.55);

  --shadow: 0 10px 30px rgba(0,0,0,.40);
  --radius: 14px;

  /* status palette: bg / border / foreground */
  --ok-bg:#12331d;    --ok-bd:#1f5a30;    --ok-fg:#6fd88b;
  --warn-bg:#4a3a10;  --warn-bd:#8a6a1a;  --warn-fg:#f2c85e;
  --amber-bg:#43290f; --amber-bd:#8a5a1a; --amber-fg:#f0a45e;
  --fault-bg:#4a1f12; --fault-bd:#8a3a22; --fault-fg:#f08a66;
  --alarm-bg:#4a1518; --alarm-bd:#c0343a; --alarm-fg:#ff5b62;
  --muted-bg:#2a3140; --muted-bd:#3d4658; --muted-fg:#8a97ab;
  --purple-bg:#2f1f4a;--purple-bd:#7a45c0;--purple-fg:#c69bf0;
  --green:#2ea043; --red:#e5484d;
}

@media (prefers-color-scheme: light) {
  :root {
    --bg:#eef1f6; --surface:#ffffff; --surface2:#f4f7fb; --surface3:#eaeef4;
    --border:#d9e1ec; --border-soft:#e6ecf3;
    --text:#152030; --dim:#5b6a7e; --faint:#93a1b5;
    --accent:#2f6fd0; --accent-text:#ffffff;
    --accent-soft:rgba(47,111,208,.10); --accent-border:rgba(47,111,208,.45);
    --shadow:0 8px 24px rgba(30,50,80,.10);
    --ok-bg:#e6f5eb; --ok-bd:#a9dcb8; --ok-fg:#1c7a3d;
    --warn-bg:#fdefcf; --warn-bd:#eccb7a; --warn-fg:#8a6410;
    --amber-bg:#fce6d2; --amber-bd:#eec79a; --amber-fg:#a5620f;
    --fault-bg:#fbdcd2; --fault-bd:#e6a996; --fault-fg:#9a3a1a;
    --alarm-bg:#fbd6d8; --alarm-bd:#e89aa0; --alarm-fg:#d13b41;
    --muted-bg:#e7ecf3; --muted-bd:#cdd6e2; --muted-fg:#6a7688;
    --purple-bg:#efe6fb; --purple-bd:#cdb2ec; --purple-fg:#7a3ec0;
  }
}

/* Manual override (theme.js toggle) â€” wins over the OS setting above. */
:root[data-theme="dark"] {
  --bg:#0b0f17; --surface:#131a26; --surface2:#1a2333; --surface3:#212c3f;
  --border:#26324a; --border-soft:#1e293b;
  --text:#e6ecf4; --dim:#93a1b5; --faint:#5d6b80;
  --accent:#3d7fe0; --accent-text:#ffffff;
  --accent-soft:rgba(61,127,224,.15); --accent-border:rgba(61,127,224,.55);
  --shadow:0 10px 30px rgba(0,0,0,.40);
  --ok-bg:#12331d; --ok-bd:#1f5a30; --ok-fg:#6fd88b;
  --warn-bg:#4a3a10; --warn-bd:#8a6a1a; --warn-fg:#f2c85e;
  --amber-bg:#43290f; --amber-bd:#8a5a1a; --amber-fg:#f0a45e;
  --fault-bg:#4a1f12; --fault-bd:#8a3a22; --fault-fg:#f08a66;
  --alarm-bg:#4a1518; --alarm-bd:#c0343a; --alarm-fg:#ff5b62;
  --muted-bg:#2a3140; --muted-bd:#3d4658; --muted-fg:#8a97ab;
  --purple-bg:#2f1f4a; --purple-bd:#7a45c0; --purple-fg:#c69bf0;
}
:root[data-theme="light"] {
  --bg:#eef1f6; --surface:#ffffff; --surface2:#f4f7fb; --surface3:#eaeef4;
  --border:#d9e1ec; --border-soft:#e6ecf3;
  --text:#152030; --dim:#5b6a7e; --faint:#93a1b5;
  --accent:#2f6fd0; --accent-text:#ffffff;
  --accent-soft:rgba(47,111,208,.10); --accent-border:rgba(47,111,208,.45);
  --shadow:0 8px 24px rgba(30,50,80,.10);
  --ok-bg:#e6f5eb; --ok-bd:#a9dcb8; --ok-fg:#1c7a3d;
  --warn-bg:#fdefcf; --warn-bd:#eccb7a; --warn-fg:#8a6410;
  --amber-bg:#fce6d2; --amber-bd:#eec79a; --amber-fg:#a5620f;
  --fault-bg:#fbdcd2; --fault-bd:#e6a996; --fault-fg:#9a3a1a;
  --alarm-bg:#fbd6d8; --alarm-bd:#e89aa0; --alarm-fg:#d13b41;
  --muted-bg:#e7ecf3; --muted-bd:#cdd6e2; --muted-fg:#6a7688;
  --purple-bg:#efe6fb; --purple-bd:#cdb2ec; --purple-fg:#7a3ec0;
}

/* Theme toggle button (injected by theme.js) */
.theme-toggle {
  position:fixed; top:14px; right:14px; z-index:2000;
  padding:8px 14px; border:1px solid var(--border); border-radius:9px;
  background:var(--surface); color:var(--dim);
  font:500 12px/1 var(--font); cursor:pointer; box-shadow:var(--shadow);
}
.theme-toggle:hover { color:var(--text); }

/* ============================================================================
   APP SHELL â€” sidebar + topbar. The sidebar + .app-main wrappers are baked into
   each page's HTML; the page's own .header is restyled here into the topbar.
   theme.js only adds the toggle + hamburger controls.
   ========================================================================== */
.app-shell { display:flex; min-height:100vh; }
.sidebar {
  width:236px; flex-shrink:0; position:sticky; top:0; height:100vh;
  background:var(--surface); border-right:1px solid var(--border);
  padding:20px 16px; display:flex; flex-direction:column; gap:6px;
}
.app-brand { display:flex; align-items:center; gap:11px; padding:6px 8px 18px; }
.brand-mark { width:38px; height:38px; border-radius:10px; background:var(--accent); color:var(--accent-text); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:20px; }
.brand-name { font-weight:700; font-size:14px; letter-spacing:.14em; }
.brand-sub { font-size:11px; color:var(--dim); }
.sidebar-nav { display:flex; flex-direction:column; gap:4px; flex:1; }
.sidebar-nav a { display:flex; align-items:center; gap:12px; padding:11px 13px; border-radius:10px; color:var(--dim); font-size:14px; font-weight:500; }
.sidebar-nav a:hover { background:var(--surface2); color:var(--text); text-decoration:none; }
.sidebar-nav a.active { background:var(--accent-soft); color:var(--accent); font-weight:600; }
.sidebar-nav svg { width:19px; height:19px; flex-shrink:0; }
.sidebar-logout { display:flex; align-items:center; gap:12px; padding:11px 13px; border-radius:10px; border:1px solid var(--border); color:var(--dim); font-size:14px; font-weight:500; margin-top:6px; cursor:pointer; }
.sidebar-logout:hover { color:var(--red); border-color:var(--red); text-decoration:none; }
.sidebar-scrim { display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:55; }

.app-main { flex:1; min-width:0; max-width:1240px; margin:0 auto; width:100%; padding:0 24px 40px; }

/* The page's existing .header becomes the sticky topbar */
.app-shell .header {
  position:sticky; top:0; z-index:40; margin:0 -24px 22px; border:none;
  border-bottom:1px solid var(--border); border-radius:0; text-align:left;
  display:flex; align-items:center; gap:14px; flex-wrap:wrap; padding:14px 24px;
  background:color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter:blur(10px);
}
.app-shell .header h1 { font-size:18px; font-weight:600; letter-spacing:0; text-shadow:none; margin:0; color:var(--text); }
.app-shell div.nav { display:none; }                      /* sidebar replaces every in-page text nav (div.nav; not the keypad's .key.nav buttons) */
.app-shell .header .status, .app-shell .header .status-bar { margin:0 0 0 auto; gap:8px; }
.app-shell .header .theme-toggle { position:static; box-shadow:none; }
.app-hamburger { display:none; padding:8px; border-radius:9px; border:1px solid var(--border); background:var(--surface); color:var(--text); cursor:pointer; }

/* Neutralize old per-page container centering now that .app-main owns the width */
.app-main > .container { max-width:none; padding:0; margin:0; }
.app-main .grid-container, .app-main .area-container, .app-main .legend, .app-main .controls { max-width:none; padding-left:0; padding-right:0; margin-left:0; margin-right:0; }
/* settings has no topbar â€” keep its in-container <h1>/subtitle as the page heading */

@media (max-width:880px) {
  .sidebar { position:fixed; top:0; left:0; bottom:0; z-index:60; transform:translateX(-110%); transition:transform .26s ease; }
  .sidebar.open { transform:translateX(0); box-shadow:0 0 40px rgba(0,0,0,.5); }
  .sidebar-scrim.open { display:block; }
  .app-hamburger { display:inline-flex; }
  .app-main { padding:0 14px 40px; }
  .app-shell .header { margin:0 -14px 16px; padding:12px 14px; }
  .app-shell .header .status, .app-shell .header .status-bar { display:none; }
}

* { margin:0; padding:0; box-sizing:border-box; }
html, body { min-height:100%; }
body {
  font-family:var(--font);
  background:var(--bg);
  color:var(--text);
  padding:0;
  -webkit-font-smoothing:antialiased;
  line-height:1.45;
}
a { color:var(--accent); text-decoration:none; }
a:hover { text-decoration:underline; }
::-webkit-scrollbar { width:10px; height:10px; }
::-webkit-scrollbar-thumb { background:rgba(128,140,160,.35); border-radius:6px; }
::-webkit-scrollbar-track { background:transparent; }

/* ---- Header + top navigation (sticky top bar with pill nav) ---------------- */
.header {
  position:sticky; top:0; z-index:40;
  text-align:center;
  margin:0 0 24px;
  padding:16px 20px;
  background:color-mix(in srgb, var(--bg) 82%, transparent);
  backdrop-filter:blur(10px);
  border:none;
  border-bottom:1px solid var(--border);
  border-radius:0;
}
.header h1 {
  font-size:15px; font-weight:700; letter-spacing:.14em;
  color:var(--text); text-shadow:none; margin-bottom:12px;
}

/* Text-link nav â†’ pill row. font-size:0 collapses the literal " | " separators
   and whitespace between links without any markup change. */
.nav { font-size:0; margin:0 auto 4px; display:flex; flex-wrap:wrap; gap:6px; justify-content:center; }
.nav a {
  font-size:13px; font-weight:500;
  color:var(--dim); text-decoration:none;
  margin:0; padding:8px 14px; border-radius:9px;
  background:transparent; border:1px solid transparent;
  transition:background .15s, color .15s;
  display:inline-block;
}
.nav a:hover { color:var(--text); background:var(--surface2); text-decoration:none; }
.nav a.active,
.nav a[style*="font-weight:bold"], .nav a[style*="font-weight: bold"] {
  color:var(--accent); background:var(--accent-soft);
}
.nav .nav-logout, .nav a[href="#"] { color:var(--red); }
.nav .nav-logout:hover, .nav a[href="#"]:hover { background:color-mix(in srgb, var(--red) 12%, transparent); color:var(--red); }

/* ---- Status indicators / badges ------------------------------------------ */
.status, .status-bar {
  display:flex; justify-content:center; gap:8px; flex-wrap:wrap; margin-top:4px; font-size:12px;
}
.status-indicator, .status-badge, .badge {
  display:inline-flex; align-items:center; gap:7px;
  padding:6px 13px; border-radius:999px;
  font-size:12px; font-weight:600;
  background:var(--surface); border:1px solid var(--border); color:var(--dim);
}
.status-indicator.connected, .status-badge.badge-connected, .badge.badge-ok,
.status-indicator.ok, .badge-ac-ok, .badge-batt-ok {
  color:var(--ok-fg); background:var(--ok-bg); border-color:var(--ok-bd);
}
.status-indicator.disconnected, .status-badge.badge-disconnected, .badge.badge-fail,
.status-indicator.error, .badge-ac-fail, .badge-batt-fail {
  color:var(--alarm-fg); background:var(--alarm-bg); border-color:var(--alarm-bd);
}
.badge-info { color:var(--dim); border-color:var(--border); background:var(--surface); }

/* ---- Section titles ------------------------------------------------------- */
.section-title {
  font-size:12px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
  color:var(--accent); text-shadow:none;
  margin:22px auto 12px; text-align:center;
}

/* ---- Layout container ----------------------------------------------------- */
.container { max-width:1180px; margin:0 auto; padding:0 20px 40px; }
body > .header + .section-title,
body > .header + .area-container,
body > .header ~ .grid-container,
body > .header ~ .legend { /* zones page has no .container wrapper */ }
body > .grid-container, body > .area-container, body > .legend { max-width:1180px; margin-left:auto; margin-right:auto; }

/* ============================================================================
   ZONES PAGE
   ========================================================================== */
.area-container { display:flex; flex-wrap:wrap; justify-content:center; gap:10px; margin:0 auto 24px; padding:0 20px; max-width:1180px; }
.area {
  background:var(--surface); padding:12px; border-radius:12px;
  border:2px solid var(--border); width:150px; font-size:12px;
  display:flex; flex-direction:column; gap:8px; transition:transform .15s, box-shadow .15s;
}
.area:hover { transform:translateY(-2px); box-shadow:var(--shadow); }
.area-header { font-weight:700; font-family:var(--mono); }
.area-controls { display:flex; gap:6px; }
.area-controls button {
  flex:1; padding:7px 4px; font-size:11px; font-weight:700;
  border:none; border-radius:7px; cursor:pointer; color:#fff; transition:filter .15s, transform .1s;
}
.area-controls button:hover { filter:brightness(1.15); }
.area-controls button:active { transform:translateY(1px); }
.btn-arm { background:#c62834; } .btn-part { background:#7a3ec0; } .btn-disarm { background:#2ea043; }

.area.normal, .area.secured { background:var(--surface); border-color:var(--border); }
.area.ready { background:var(--accent-soft); border-color:var(--accent-border); }
.area.not-ready { background:var(--warn-bg); border-color:var(--warn-bd); }
.area.exit { background:var(--amber-bg); border-color:var(--amber-bd); animation:orisecPulse 1.2s infinite; }
.area.entry { background:var(--warn-bg); border-color:var(--warn-bd); animation:orisecPulse 1.2s infinite; }
.area.part_armed { background:var(--purple-bg); border-color:var(--purple-bd); }
.area.armed { background:var(--alarm-bg); border-color:var(--alarm-bd); }
.area.alarm { background:var(--alarm-bg); border-color:var(--alarm-bd); animation:orisecPulse 1.1s infinite; }

.grid-container {
  display:grid;
  grid-template-columns:repeat(10, minmax(54px, 1fr));  /* Orisec expands in banks of 10: one row = one bank */
  /* overflow-x:auto (for the 10-wide banks on narrow screens) forces overflow-y
     to auto too, so the vertical padding must leave room for the zone hover
     scale(1.08) + shadow - otherwise top/bottom rows clip or add a scrollbar. */
  gap:7px; width:100%; max-width:1180px; margin:0 auto; padding:12px 20px; overflow-x:auto;
}
.zone {
  background:var(--surface); padding:8px 3px; text-align:center;
  font-family:var(--mono); font-size:12px; font-weight:600;
  border-radius:9px; border:1px solid var(--border); cursor:pointer;
  transform:scale(0.95);   /* 5% smaller at rest so the hover grow can't exceed the cell/frame */
  transition:transform .12s, box-shadow .12s;
}
.zone:hover { transform:scale(1); z-index:10; box-shadow:var(--shadow); }
.zone-state { user-select:none; }
.zone.normal { background:var(--ok-bg); border-color:var(--ok-bd); color:var(--ok-fg); }
.zone.active { background:var(--warn-bg); border-color:var(--warn-bd); color:var(--warn-fg); }
.zone.tamper { background:var(--amber-bg); border-color:var(--amber-bd); color:var(--amber-fg); }
.zone.fault { background:var(--fault-bg); border-color:var(--fault-bd); color:var(--fault-fg); }
.zone.alarm { background:var(--alarm-bg); border-color:var(--alarm-bd); color:var(--alarm-fg); animation:orisecPulse 1.1s infinite; }
.zone.bypassed { background:var(--muted-bg); border-color:var(--muted-bd); color:var(--muted-fg); }
.zone.masked { background:var(--muted-bg); border-color:var(--muted-bd); color:var(--muted-fg); }
.zone.multiple { background:var(--purple-bg); border-color:var(--purple-bd); color:var(--purple-fg); }

.legend {
  margin:24px auto 0; max-width:1180px; padding:16px 20px;
  background:var(--surface); border:1px solid var(--border); border-radius:12px; text-align:center;
}
.legend strong { color:var(--accent); }
.legend-items { display:flex; justify-content:center; gap:16px; flex-wrap:wrap; margin-top:10px; }
.legend-item { display:flex; align-items:center; gap:7px; font-size:12px; color:var(--dim); }
.legend-color { width:15px; height:15px; border-radius:4px; border:1px solid var(--border); }

/* ============================================================================
   PARTITIONS PAGE
   ========================================================================== */
.partitions-grid {
  display:grid; grid-template-columns:repeat(auto-fill, minmax(190px, 1fr));
  gap:12px; margin-bottom:22px;
}
.part-card {
  background:var(--surface); padding:16px 18px; border-radius:14px;
  border:2px solid var(--border); cursor:pointer; text-align:left; min-width:0;
  transition:transform .15s, box-shadow .15s, border-color .15s;
}
.part-card:hover { transform:translateY(-2px); box-shadow:var(--shadow); }
.part-card.selected { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft); }
.part-card.disarmed { background:var(--ok-bg); border-color:var(--ok-bd); }
.part-card.armed { background:var(--alarm-bg); border-color:var(--alarm-bd); }
.part-card.part_armed { background:var(--purple-bg); border-color:var(--purple-bd); }
.part-card.exit { background:var(--amber-bg); border-color:var(--amber-bd); }
.part-card.alarm { background:var(--alarm-bg); border-color:var(--alarm-bd); animation:orisecPulse 1.1s infinite; }
.part-num { font-family:var(--mono); font-size:20px; font-weight:700; color:var(--accent); margin-bottom:3px; }
.part-name { font-size:13px; color:var(--dim); margin-bottom:8px; }
.part-state { font-size:14px; font-weight:600; }
.part-card.disarmed .part-state { color:var(--ok-fg); }
.part-card.armed .part-state, .part-card.alarm .part-state { color:var(--alarm-fg); }
.part-card.part_armed .part-state { color:var(--purple-fg); }
.part-card.exit .part-state { color:var(--amber-fg); }
/* Outputs page: ON = energized (green highlight); OFF = neutral default card. */
.part-card.out-on { background:var(--ok-bg); border-color:var(--ok-bd); }
.part-card.out-on .part-state { color:var(--ok-fg); }
.part-card.out-on .part-num { color:var(--ok-fg); }
.part-card .btn { margin-top:10px; width:100%; }

.detail-panel {
  background:var(--surface); padding:22px; border-radius:16px;
  border:1px solid var(--border); box-shadow:var(--shadow); display:none;
}
.detail-panel.show { display:block; }
.detail-header { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:18px; }
.detail-title { font-size:18px; font-weight:600; color:var(--text); }
.detail-state-label { font-size:15px; font-weight:700; }
.detail-state-label.disarmed { color:var(--ok-fg); }
.detail-state-label.armed, .detail-state-label.alarm { color:var(--alarm-fg); }
.detail-state-label.part_armed { color:var(--purple-fg); }
.detail-state-label.exit { color:var(--amber-fg); }
.state-loading { color:var(--dim); font-size:13px; padding:5px 0; }
.flags-row { display:grid; grid-template-columns:repeat(auto-fit, minmax(120px,1fr)); gap:10px; margin-bottom:18px; }
.flag-box { background:var(--surface2); padding:12px; border-radius:10px; border:1px solid var(--border); text-align:center; }
.flag-box.active { background:var(--alarm-bg); border-color:var(--alarm-bd); }
.flag-box.active.green { background:var(--ok-bg); border-color:var(--ok-bd); }
.flag-label { font-size:12px; color:var(--dim); margin-bottom:5px; }
.flag-box.active .flag-label { color:var(--text); }
.flag-icon { font-size:18px; color:var(--faint); }
.flag-box.active .flag-icon { color:var(--alarm-fg); }
.flag-box.active.green .flag-icon { color:var(--ok-fg); }
.controls-row { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:15px; }
.btn-stay { background:#7a3ec0; color:#fff; } .btn-reset { background:var(--surface3); color:var(--text); border:1px solid var(--border); }
.raw-json { background:var(--surface2); padding:12px 15px; border-radius:10px; border:1px solid var(--border); cursor:pointer; }
.raw-json-header { font-size:12px; color:var(--accent); }
.raw-json-content { display:none; font-family:var(--mono); font-size:11px; color:var(--ok-fg); margin-top:8px; white-space:pre-wrap; word-break:break-all; max-height:300px; overflow-y:auto; }
.raw-json.open .raw-json-content { display:block; }

/* ============================================================================
   KEYPAD PAGE  â€” LCD look preserved verbatim; only the shell + keys restyled
   ========================================================================== */
.keypad-panel {
  background:var(--surface); padding:26px; border-radius:20px;
  border:1px solid var(--border); box-shadow:var(--shadow);
}
/* LCD: keep the original pixel look (do not restyle) */
.lcd { background:linear-gradient(165deg,#1b54e8,#1340c4); padding:14px 18px; border-radius:12px; margin:0 auto 22px; border:1px solid #0a1c52; box-shadow:inset 0 0 22px rgba(4,12,40,.55), 0 0 14px rgba(40,90,230,.35); width:fit-content; max-width:100%; }
#lcd-canvas { display:block; image-rendering:pixelated; width:512px; max-width:100%; }
#lcd-raw { font-family:var(--mono); font-size:11px; color:#7ad; word-break:break-all; margin:4px 2px 0; user-select:all; }

.key {
  position:relative; padding:0; min-height:58px;
  font-size:19px; font-weight:600;
  background:var(--surface2); color:var(--text);
  border:1px solid var(--border); border-radius:11px; cursor:pointer;
  box-shadow:0 2px 4px rgba(0,0,0,.25);
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1px;
  transition:filter .1s, transform .06s;
}
.key small { font-size:9px; color:var(--faint); font-weight:400; letter-spacing:.06em; }
.key:hover { filter:brightness(1.08); }
.key:active { transform:translateY(1px); filter:brightness(1.3); }
.key.fn { border-color:var(--amber-bd); color:var(--amber-fg); }
.key.fn small { color:var(--faint); }
.key.enter { border-color:var(--green); color:var(--green); }
.key.clear { border-color:var(--red); color:var(--red); }
.key.nav { border-color:var(--accent); color:var(--accent); font-size:22px; }
/* Keypad body grid + nav-key sizing (restored from the page's original inline CSS) */
.keypad-panel { max-width:760px; margin:0 auto; }
.keypad-body {
  display:grid;
  grid-template-columns:repeat(4, 1fr) 22px 1fr 1fr;
  grid-auto-rows:64px; gap:10px; justify-content:center;
  grid-template-areas:
    'n1 n2 n3 fa . up up'
    'n4 n5 n6 fb . lt rt'
    'n7 n8 n9 fc . dn dn'
    'ne n0 nc fd . ch bk';
}
.key.nav { justify-self:center; width:64px; padding:0; }

/* ============================================================================
   OUTPUTS PAGE
   ========================================================================== */
.controls {
  text-align:center; margin:0 auto 20px; padding:16px 20px;
  background:var(--surface); border-radius:14px; border:1px solid var(--border);
  display:flex; flex-wrap:wrap; gap:12px; align-items:center; justify-content:center; max-width:1180px;
}
.control-group { display:inline-flex; gap:10px; align-items:center; margin:0; }
.control-group label { font-size:13px; color:var(--dim); font-weight:600; }
.control-group select {
  padding:11px 14px; background:var(--surface2); color:var(--text);
  border:1px solid var(--border); border-radius:10px; font-size:14px; outline:none;
}
.control-group button {
  padding:11px 18px; font-size:13px; font-weight:600; border-radius:10px; cursor:pointer;
  border:1px solid var(--border); color:var(--text); background:var(--surface2); transition:filter .15s;
}
.control-group button:hover { filter:brightness(1.1); }
.btn-on, .btn-all-on { background:var(--accent-soft); border-color:var(--accent-border); color:var(--accent); }
.btn-off, .btn-all-off { background:var(--surface2); border-color:var(--border); color:var(--dim); }
.location-group { margin:0 auto; padding:0; background:transparent; border:none; }
.outputs-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(150px,1fr)); gap:12px; margin-top:12px; }
.output {
  background:var(--surface); padding:18px 14px; text-align:center;
  border-radius:13px; border:2px solid var(--border); cursor:pointer;
  transition:transform .15s, box-shadow .15s;
}
.output:hover { transform:translateY(-2px); box-shadow:var(--shadow); }
.output.on { background:var(--accent-soft); border-color:var(--accent-border); box-shadow:0 0 0 3px var(--accent-soft); }
.output.off { background:var(--surface); border-color:var(--border); }
.output.loading { opacity:.5; cursor:wait; }
.output-label { font-weight:600; font-size:13px; margin-bottom:8px; color:var(--dim); }
.output.on .output-label { color:var(--accent); }
.output-state { font-family:var(--mono); font-size:18px; font-weight:700; margin-top:5px; }
.output.on .output-state { color:var(--accent); }
.output.off .output-state { color:var(--faint); }

/* ============================================================================
   SYSTEM STATUS PAGE
   ========================================================================== */
.section {
  background:var(--surface); border-radius:16px; border:1px solid var(--border);
  margin-bottom:16px; padding:22px;
}
.section h2 {
  font-size:13px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
  color:var(--accent); margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid var(--border);
}
.info-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(140px,1fr)); gap:10px; margin-bottom:10px; }
.info-card { background:var(--surface2); padding:14px 16px; border-radius:11px; border:1px solid var(--border-soft); min-width:0; }
/* Settings key/value rows. info-grid tiles need each pair wrapped in .info-card
   (see System page); kv-grid takes FLAT alternating label/value divs and lays them
   out as aligned rows - label | value | label | value - so pairs can never shear.
   Collapses to one pair per row on narrow screens. */
.kv-grid { display:grid; grid-template-columns:minmax(130px,max-content) 1fr minmax(130px,max-content) 1fr; column-gap:22px; margin-bottom:4px; }
.kv-grid .info-label, .kv-grid .info-value {
  margin:0; padding:8px 0; border-bottom:1px solid var(--border-soft); align-self:center; min-width:0;
}
.kv-grid .info-label { font-size:11px; }
.kv-grid .info-value { font-size:14px; font-weight:600; overflow-wrap:anywhere; }
@media (max-width:900px){ .kv-grid { grid-template-columns:minmax(110px,max-content) 1fr; } }
.note-warn { margin-top:14px; color:var(--amber-fg); font-size:13px; }
.kv-tag { color:var(--faint); font-size:11px; font-weight:400; }
/* Debug-only protocol-command hint (only emitted when CONFIG_ORISEC_UI_DEBUG=y). */
.cmd-hint { color:var(--faint); font-weight:400; font-size:11px; letter-spacing:0; text-transform:none; }
.note-dim { color:var(--dim); font-size:13px; margin-bottom:15px; }
.subcard { background:var(--surface2); border:1px solid var(--border); border-radius:11px; padding:15px; margin-bottom:15px; }
.subcard h3 { color:var(--accent); font-size:14px; font-weight:700; margin-bottom:10px; }
.info-label { font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--faint); margin-bottom:6px; }
.info-value { font-size:20px; font-weight:700; color:var(--text); }
.info-value.green { color:var(--green); } .info-value.red { color:var(--red); } .info-value.cyan { color:var(--accent); }
.voltage-bar { height:5px; background:var(--accent); border-radius:3px; margin-top:9px; transition:width .3s; }
.flag-pill {
  display:flex; align-items:center; gap:8px; padding:9px 15px; border-radius:9px;
  background:var(--surface2); border:1px solid var(--border); min-width:140px;
}
.flag-pill.active { background:var(--ok-bg); border-color:var(--ok-bd); }
.flag-pill.fault { background:var(--fault-bg); border-color:var(--fault-bd); }
.flag-dot { width:8px; height:8px; border-radius:50%; background:var(--faint); flex-shrink:0; }
.flag-pill.active .flag-dot { background:var(--green); }
.flag-pill.fault .flag-dot { background:var(--red); }
.flag-text { font-size:13px; color:var(--dim); }
.flag-pill.active .flag-text { color:var(--ok-fg); }
.flag-pill.fault .flag-text { color:var(--fault-fg); }
.timestamp { text-align:right; font-size:11px; color:var(--faint); margin-top:10px; }
.clock-row { display:flex; align-items:center; gap:26px; flex-wrap:wrap; justify-content:space-between; }
.clock-time { font-family:var(--mono); font-size:32px; font-weight:700; color:var(--accent); }
.clock-date { font-size:13px; color:var(--dim); margin-top:4px; }
.btn-sync { background:var(--surface3); color:var(--accent); } .btn-ntp { background:var(--accent-soft); color:var(--accent); }

/* ============================================================================
   BUTTONS (shared: settings / partitions / system)
   ========================================================================== */
.btn {
  padding:11px 20px; border:none; border-radius:10px;
  font-family:var(--font); font-size:14px; font-weight:600; cursor:pointer;
  transition:filter .15s, transform .1s;
}
.btn:hover { filter:brightness(1.12); }
.btn:active { transform:translateY(1px); }
.btn-primary { background:var(--accent); color:var(--accent-text); }
.btn-danger { background:#c62834; color:#fff; }
.btn-success { background:var(--green); color:#fff; }
.btn-secondary { background:var(--surface3); color:var(--text); border:1px solid var(--border); }
.btn-small { padding:8px 14px; font-size:13px; margin-left:5px; }

/* ============================================================================
   SETTINGS PAGE
   ========================================================================== */
.container > h1, body > .container h1 { font-size:24px; font-weight:600; color:var(--text); text-shadow:none; margin-bottom:6px; }
.subtitle { color:var(--dim); margin-bottom:26px; font-size:14px; }
.info-value { font-family:var(--font); }
.users-list { margin-top:8px; }
.user-card {
  background:var(--surface2); border:1px solid var(--border-soft); border-radius:11px;
  padding:14px 16px; margin-bottom:9px; display:flex; justify-content:space-between; align-items:center;
}
.user-info strong { color:var(--text); font-size:15px; }
.user-role { display:inline-block; padding:3px 10px; border-radius:6px; font-size:11px; font-weight:700; letter-spacing:.05em; margin-left:10px; }
.role-admin { background:var(--amber-bg); color:var(--amber-fg); border:1px solid var(--amber-bd); }
.role-viewer { background:var(--ok-bg); color:var(--ok-fg); border:1px solid var(--ok-bd); }
.error { background:var(--alarm-bg); border:1px solid var(--alarm-bd); border-radius:10px; padding:12px; margin-bottom:20px; color:var(--alarm-fg); }
.loading { text-align:center; color:var(--dim); padding:40px; }
.form-group { margin-bottom:15px; }
.form-group label { display:block; margin-bottom:6px; color:var(--dim); font-size:13px; }
.form-group input, .form-group select, .form-group textarea {
  width:100%; padding:10px 12px; background:var(--surface2);
  border:1px solid var(--border); border-radius:10px; color:var(--text); font-size:14px; outline:none;
}
.form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color:var(--accent); }
/* Checkboxes: inline with their label text, not full-width form fields. */
.form-group input[type="checkbox"] {
  width:auto; padding:0; margin-right:8px; vertical-align:-2px; accent-color:var(--accent);
}
.form-actions { display:flex; gap:10px; justify-content:flex-end; margin-top:20px; }
.modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:1000; align-items:center; justify-content:center; padding:20px; }
.modal.show { display:flex; }
.modal-content { background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:28px; max-width:520px; width:100%; box-shadow:var(--shadow); max-height:90vh; overflow-y:auto; }
.modal-header { font-size:18px; font-weight:600; color:var(--text); margin-bottom:20px; padding-bottom:12px; border-bottom:1px solid var(--border); }

/* ============================================================================
   LOGIN PAGE (standalone â€” no app-shell/sidebar)
   ========================================================================== */
body:has(.login-container) { display:flex; align-items:center; justify-content:center; min-height:100vh; padding:20px; }
.login-container { width:100%; max-width:400px; margin:8vh auto; background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:40px; box-shadow:var(--shadow); }
.login-container h1 { text-align:center; font-size:26px; font-weight:700; letter-spacing:0; color:var(--text); margin-bottom:8px; }
.login-container .subtitle { text-align:center; margin-bottom:28px; }
.login-container button { width:100%; padding:14px; background:var(--accent); color:var(--accent-text); border:none; border-radius:10px; font-size:16px; font-weight:600; cursor:pointer; transition:filter .15s; }
.login-container button:hover { filter:brightness(1.08); }
.login-container button:disabled { background:var(--surface3); color:var(--faint); cursor:not-allowed; }
#login-form.hide { display:none; }
#change-password-form { display:none; }
#change-password-form.show { display:block; }
.login-container .error { display:none; }
.login-container .error.show { display:block; }
.warning { background:var(--warn-bg); border:1px solid var(--warn-bd); border-radius:10px; padding:12px; margin-bottom:20px; color:var(--warn-fg); font-size:14px; }
.login-container .loading { display:none; padding:0; margin-top:20px; }
.login-container .loading.show { display:block; }
.password-requirements { font-size:12px; color:var(--dim); margin-top:8px; line-height:1.6; }
.password-requirements ul { margin-left:20px; margin-top:5px; }

/* ---- Animations ----------------------------------------------------------- */
@keyframes orisecPulse { 0%,100% { opacity:1; } 50% { opacity:.55; } }
/* Legacy keyframe names some pages reference inline */
@keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:.6; } }
@keyframes pulse-alarm { 0%,100% { opacity:1; } 50% { opacity:.7; } }
@keyframes flash-red { 0%,100% { opacity:1; } 50% { opacity:.7; } }
@keyframes flash-amber { 0%,100% { opacity:1; } 50% { opacity:.7; } }
@keyframes flash-yellow { 0%,100% { opacity:1; } 50% { opacity:.7; } }

/* ---- Responsive ----------------------------------------------------------- */
@media (max-width:768px) {
  .header { padding:12px 14px; margin-bottom:16px; }
  .container { padding:0 14px 80px; }
  .grid-container, .area-container, .legend, .controls { padding-left:14px; padding-right:14px; }
  .grid-container { grid-template-columns:repeat(10, minmax(38px,1fr)); gap:5px; }  /* keep banks of 10 on mobile (scrolls if tight) */
  .outputs-grid { grid-template-columns:repeat(auto-fill, minmax(130px,1fr)); }
  .clock-time { font-size:26px; }
  .modal-content { padding:20px; }
  .btn { padding:10px 16px; }
}
␀<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orisec Gateway - System Status</title>
<link rel="stylesheet" href="/ui/theme.css">
</head>
<body>
<div class="app-shell">
<aside class="sidebar">
<div class="app-brand"><div class="brand-mark">O</div><div><div class="brand-name">ORISEC</div><div class="brand-sub">Gateway</div></div></div>
<nav class="sidebar-nav">
<a href="/ui/zones"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1.3"/><rect x="14" y="3" width="7" height="7" rx="1.3"/><rect x="3" y="14" width="7" height="7" rx="1.3"/><rect x="14" y="14" width="7" height="7" rx="1.3"/></svg><span>Zones</span></a>
<a href="/ui/areas"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="5" rx="1.3"/><rect x="3" y="15" width="18" height="5" rx="1.3"/></svg><span>Partitions</span></a>
<a href="/ui/keypad"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="6" cy="6" r="1.9"/><circle cx="12" cy="6" r="1.9"/><circle cx="18" cy="6" r="1.9"/><circle cx="6" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="18" cy="12" r="1.9"/><circle cx="6" cy="18" r="1.9"/><circle cx="12" cy="18" r="1.9"/><circle cx="18" cy="18" r="1.9"/></svg><span>Keypad</span></a>
<a href="/ui/outputs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3v9"/><path d="M6.5 7a8 8 0 1 0 11 0"/></svg><span>Outputs</span></a>
<a href="/ui/system-flags" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 5 15L17 12h4"/></svg><span>System</span></a>
<a href="/ui/settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><line x1="4" y1="8" x2="20" y2="8"/><circle cx="9" cy="8" r="2.4" fill="currentColor" stroke="none"/><line x1="4" y1="16" x2="20" y2="16"/><circle cx="15" cy="16" r="2.4" fill="currentColor" stroke="none"/></svg><span>Settings</span></a>
</nav>
<a href="#" class="sidebar-logout" onclick="if(typeof logout===&quot;function&quot;){logout();}else{location.href=&quot;/ui/login&quot;;}return false;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3"/><path d="M10 8l-4 4 4 4"/><path d="M6 12h9"/></svg><span>Logout</span></a>
</aside>
<div class="sidebar-scrim"></div>
<div class="app-main">
<div class="header">
<h1>ORISEC GATEWAY - SYSTEM STATUS</h1>
<div class="nav">
<a href="/ui/zones">Zones</a> | <a href="/ui/areas">Partitions</a> | <a href="/ui/keypad">Keypad</a> | <a href="/ui/outputs">Outputs</a> | <a href="/ui/system-flags" style="font-weight:bold;">System Flags</a> | <a href="/ui/settings">Settings</a> | <a href="#" onclick="logout(); return false;" style="color:#ff6b6b;">Logout</a>
</div>
<div class="status-bar">
<span class="badge badge-info" id="conn-badge">DISCONNECTED</span>
<span class="badge badge-info" id="time-badge">Last Update: --</span>
<span class="badge badge-info" id="ac-badge">AC: --</span>
<span class="badge badge-info" id="batt-badge">BATT: --</span>
</div>
</div>
<div class="container">
<!-- PANEL section -->
<div class="section">
<div class="section-title">PANEL</div>
<div class="info-grid">
<div class="info-card"><div class="info-label">Connection</div><div class="info-value green" id="panel-conn">--</div></div>
<div class="info-card"><div class="info-label">Model</div><div class="info-value" id="panel-model">--</div></div>
<div class="info-card"><div class="info-label">Firmware</div><div class="info-value" id="panel-fw">--</div></div>
<div class="info-card"><div class="info-label">Serial Number</div><div class="info-value" id="panel-serial">--</div></div>
</div>
<div class="info-grid">
<div class="info-card"><div class="info-label">Zones</div><div class="info-value" id="panel-zones">--</div></div>
<div class="info-card"><div class="info-label">Partitions</div><div class="info-value" id="panel-parts">--</div></div>
</div>
</div>
<!-- POWER section -->
<div class="section">
<div class="section-title">POWER</div>
<div class="info-grid">
<div class="info-card"><div class="info-label">System Voltage</div><div class="info-value cyan" id="pwr-mains">--</div><div class="voltage-bar" id="pwr-mains-bar" style="width:0%"></div></div>
<div class="info-card"><div class="info-label">Battery Voltage</div><div class="info-value cyan" id="pwr-batt">--</div><div class="voltage-bar" id="pwr-batt-bar" style="width:0%"></div></div>
<div class="info-card"><div class="info-label">AC Mains</div><div class="info-value" id="pwr-ac">--</div></div>
</div>
<div class="flags-row" id="pwr-flags"></div>
<div class="timestamp" id="pwr-ts"></div>
</div>
<!-- SYSTEM STATUS section -->
<div class="section">
<div class="section-title">SYSTEM STATUS</div>
<div class="flags-row" id="sys-flags"></div>
<div class="timestamp" id="sys-ts"></div>
</div>
<!-- GATEWAY CLOCK section -->
<div class="section">
<div class="section-title">GATEWAY CLOCK</div>
<div class="clock-row">
<div>
<div class="info-label">TIME</div>
<div class="clock-time" id="clock-time">--:--:--</div>
<div class="clock-date" id="clock-date"></div>
</div>
<div style="display:flex; gap:10px; flex-wrap:wrap;">
<button class="btn btn-sync" id="btn-sync" onclick="syncTime()">Sync Time to Panel</button>
<button class="btn btn-ntp" id="btn-ntp" onclick="forceNtp()">Force NTP Sync</button>
</div>
</div>
</div>
</div>
<script>
const token = localStorage.getItem('auth_token');
if (!token) window.location.href = '/ui/login';

async function authFetch(url, options = {}) {
  options.headers = options.headers || {};
  options.headers['Authorization'] = 'Bearer ' + token;
  const r = await fetch(url, options);
  if (r.status === 401) { localStorage.clear(); window.location.href = '/ui/login'; throw new Error('Session expired'); }
  return r;
}

async function logout() {
  await authFetch('/api/logout', { method: 'POST' }).catch(() => {});
  localStorage.clear(); window.location.href = '/ui/login';
}

function ts() { return new Date().toLocaleTimeString(); }

// Panel info
async function loadPanel() {
  try {
    const r = await authFetch('/healthz');
    const h = await r.json();
    const cb = document.getElementById('conn-badge');
    const pc = document.getElementById('panel-conn');
    if (h.panel_online) {
      cb.textContent = 'CONNECTED'; cb.className = 'badge badge-ok';
      pc.textContent = 'Online'; pc.className = 'info-value green';
    } else {
      cb.textContent = 'DISCONNECTED'; cb.className = 'badge badge-fail';
      pc.textContent = 'Offline'; pc.className = 'info-value red';
    }
  } catch(e) {}
  try {
    const r = await authFetch('/info');
    const d = await r.json();
    if (d.panel) {
      document.getElementById('panel-model').textContent = d.panel.model || '--';
      document.getElementById('panel-fw').textContent = d.panel.fw || '--';
      document.getElementById('panel-serial').textContent = d.panel.serial || '--';
      document.getElementById('panel-zones').textContent = d.panel.max_zones || '--';
      document.getElementById('panel-parts').textContent = d.panel.partitions || '--';
    }
  } catch(e) {}
}

// Power
async function loadPower() {
  try {
    const r = await authFetch('/api/system/power');
    const d = await r.json();
    if (d.ok) {
      const mv = d.mains_volts || 0;
      const bv = d.battery_volts || 0;
      document.getElementById('pwr-mains').textContent = mv.toFixed(1) + 'V';
      document.getElementById('pwr-batt').textContent = bv.toFixed(1) + 'V';
      // Bars: 0-15V range
      document.getElementById('pwr-mains-bar').style.width = Math.min(100, (mv/15)*100) + '%';
      document.getElementById('pwr-batt-bar').style.width = Math.min(100, (bv/15)*100) + '%';
      const acEl = document.getElementById('pwr-ac');
      if (d.psu_ac_fail) { acEl.textContent = 'Fail'; acEl.className = 'info-value red'; }
      else { acEl.textContent = 'Present'; acEl.className = 'info-value green'; }
      // AC/Batt badges
      const ab = document.getElementById('ac-badge');
      const bb = document.getElementById('batt-badge');
      if (d.psu_ac_fail) { ab.textContent = 'AC: FAIL'; ab.className = 'badge badge-fail'; }
      else { ab.textContent = 'AC: OK'; ab.className = 'badge badge-ok'; }
      if (d.psu_battery_fail) { bb.textContent = 'BATT: FAIL'; bb.className = 'badge badge-fail'; }
      else { bb.textContent = 'BATT: OK'; bb.className = 'badge badge-ok'; }
      // Power flag pills
      const pf = document.getElementById('pwr-flags');
      pf.innerHTML = '';
      [{k:'psu_ac_fail',l:'AC Present',inv:true},{k:'psu_ac_fail',l:'AC Fail',inv:false},{k:'psu_battery_fail',l:'Battery Fail',inv:false},{k:'psu_fuse_blown',l:'Fuse Blown',inv:false}].forEach(f => {
        const active = f.inv ? !d[f.k] : d[f.k];
        const isFault = !f.inv && active;
        const pill = document.createElement('div');
        pill.className = `flag-pill ${active ? (isFault ? 'fault' : 'active') : ''}`;
        pill.innerHTML = `<div class="flag-dot"></div><div class="flag-text">${f.l}</div>`;
        pf.appendChild(pill);
      });
      document.getElementById('pwr-ts').textContent = 'Updated ' + ts();
    }
  } catch(e) {}
}

// System flags
async function loadSysFlags() {
  try {
    const r = await authFetch('/api/system/sflags');
    const d = await r.json();
    if (d.ok) {
      const sf = document.getElementById('sys-flags');
      sf.innerHTML = '';
      // /api/system/sflags is the correct Orisec 8-bit GETSFLAGS decode (fields
      // at top level). The old /api/system/flags path applied a legacy Texecom
      // 64-bit layout that dropped bit0 (General Fault) and inverted bit1 (it
      // read AC On as 'mains_power_off'). Bit order here matches the panel:
      // 0 GeneralFault, 1 AC On, 2 Battery, 3 Fuse, 4 Tamper, 5 Coms, 7 Engineer.
      const defs = [
        {k:'general_fault',l:'General Fault',ok:false},
        {k:'ac_on',l:'AC On',ok:true},
        {k:'battery_fault',l:'Battery Fault',ok:false},
        {k:'fuse_fault',l:'Fuse Fault',ok:false},
        {k:'tamper',l:'Tamper',ok:false},
        {k:'coms_fault',l:'Coms Fault',ok:false},
        {k:'engineer_on_site',l:'Engineer On Site',ok:false}
      ];
      defs.forEach(f => {
        const active = !!d[f.k];
        const pill = document.createElement('div');
        pill.className = `flag-pill ${active ? (f.ok ? 'active' : 'fault') : ''}`;
        pill.innerHTML = `<div class="flag-dot"></div><div class="flag-text">${f.l}</div>`;
        sf.appendChild(pill);
      });
      // TEMP: raw GETSFLAGS byte shown for debugging the AC-On/decode issue.
      document.getElementById('sys-ts').textContent = 'Updated ' + ts() + ' (raw: ' + (d.raw || '?') + ')';
    }
  } catch(e) {}
}

// Clock
function updateClock() {
  const now = new Date();
  document.getElementById('clock-time').textContent = now.toLocaleTimeString();
  document.getElementById('clock-date').textContent = now.toLocaleDateString(undefined, {weekday:'long',year:'numeric',month:'long',day:'numeric'});
  document.getElementById('time-badge').textContent = 'Last Update: ' + now.toLocaleTimeString();
}

async function syncTime() {
  try {
    const r = await authFetch('/sync-time', { method: 'POST' });
    const d = await r.json();
    alert(d.ok ? 'Time synced to panel' : (d.error || 'Sync failed'));
  } catch(e) { alert('Failed: ' + e.message); }
}

async function forceNtp() {
  try {
    const r = await authFetch('/api/force-ntp-sync', { method: 'POST' });
    const d = await r.json();
    alert(d.ok ? 'NTP sync complete' : (d.error || 'NTP sync failed'));
  } catch(e) { alert('Failed: ' + e.message); }
}

// Init
loadPanel();
loadPower();
loadSysFlags();
updateClock();
setInterval(updateClock, 1000);
setInterval(() => { loadPanel(); loadPower(); loadSysFlags(); }, 15000);
</script>
</div>
</div>
<script src="/ui/theme.js"></script>
</body>
</html>
␀␀␀
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - Orisec Gateway</title>
    <link rel="stylesheet" href="/ui/theme.css">
</head>
<body>
<div class="app-shell">
<aside class="sidebar">
<div class="app-brand"><div class="brand-mark">O</div><div><div class="brand-name">ORISEC</div><div class="brand-sub">Gateway</div></div></div>
<nav class="sidebar-nav">
<a href="/ui/zones"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1.3"/><rect x="14" y="3" width="7" height="7" rx="1.3"/><rect x="3" y="14" width="7" height="7" rx="1.3"/><rect x="14" y="14" width="7" height="7" rx="1.3"/></svg><span>Zones</span></a>
<a href="/ui/areas"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="5" rx="1.3"/><rect x="3" y="15" width="18" height="5" rx="1.3"/></svg><span>Partitions</span></a>
<a href="/ui/keypad"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="6" cy="6" r="1.9"/><circle cx="12" cy="6" r="1.9"/><circle cx="18" cy="6" r="1.9"/><circle cx="6" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="18" cy="12" r="1.9"/><circle cx="6" cy="18" r="1.9"/><circle cx="12" cy="18" r="1.9"/><circle cx="18" cy="18" r="1.9"/></svg><span>Keypad</span></a>
<a href="/ui/outputs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3v9"/><path d="M6.5 7a8 8 0 1 0 11 0"/></svg><span>Outputs</span></a>
<a href="/ui/system-flags"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 5 15L17 12h4"/></svg><span>System</span></a>
<a href="/ui/settings" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><line x1="4" y1="8" x2="20" y2="8"/><circle cx="9" cy="8" r="2.4" fill="currentColor" stroke="none"/><line x1="4" y1="16" x2="20" y2="16"/><circle cx="15" cy="16" r="2.4" fill="currentColor" stroke="none"/></svg><span>Settings</span></a>
</nav>
<a href="#" class="sidebar-logout" onclick="if(typeof logout===&quot;function&quot;){logout();}else{location.href=&quot;/ui/login&quot;;}return false;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3"/><path d="M10 8l-4 4 4 4"/><path d="M6 12h9"/></svg><span>Logout</span></a>
</aside>
<div class="sidebar-scrim"></div>
<div class="app-main">

    <div class="container">
        <h1>Settings</h1>
        <p class="subtitle">System Configuration</p>

        <div class="nav">
            <a href="/ui/zones">Zones</a> | <a href="/ui/areas">Partitions</a> | <a href="/ui/keypad">Keypad</a> | <a href="/ui/outputs">Outputs</a> | <a href="/ui/system-flags">System Flags</a> | <a href="/ui/settings">Settings</a> | <a href="#" onclick="logout(); return false;" style="color:#ff6b6b;">Logout</a>
        </div>

        <div id="error" class="error" style="display:none"></div>
        <div id="loading" class="loading">Loading settings...</div>

        <div id="content" style="display:none">
            <!-- Current User Section -->
            <div class="section">
                <h2>Current User</h2>
                <div class="kv-grid">
                    <div class="info-label">Username:</div>
                    <div class="info-value" id="current-username">-</div>

                    <div class="info-label">Role:</div>
                    <div class="info-value" id="current-role">-</div>
                </div>
            </div>

            <!-- Users Section -->
            <div class="section">
                <h2>User Accounts
                    <button class="btn btn-primary btn-small" onclick="showAddUserModal()" style="float:right;">+ Add User</button>
                </h2>
                <div id="users-list" class="users-list">
                    <!-- Users populated by JavaScript -->
                </div>
            </div>

            <!-- Network Configuration Section -->
            <div class="section">
                <h2>Network Configuration
                    <button class="btn btn-primary btn-small" onclick="showEditNetworkModal()" style="float:right;">Edit Network</button>
                </h2>
                <div class="kv-grid">
                    <div class="info-label">Mode:</div>
                    <div class="info-value" id="net-mode">-</div>

                    <div class="info-label">Static IP:</div>
                    <div class="info-value" id="net-ip">-</div>

                    <div class="info-label">Netmask:</div>
                    <div class="info-value" id="net-netmask">-</div>

                    <div class="info-label">Gateway:</div>
                    <div class="info-value" id="net-gateway">-</div>

                    <div class="info-label">DNS Primary:</div>
                    <div class="info-value" id="net-dns-primary">-</div>

                    <div class="info-label">DNS Secondary:</div>
                    <div class="info-value" id="net-dns-secondary">-</div>

                    <div class="info-label">Hostname:</div>
                    <div class="info-value" id="net-hostname">-</div>

                    <div class="info-label">HTTP Port:</div>
                    <div class="info-value" id="net-port">-</div>
                </div>
                <p class="note-warn">
                    âš ï¸ Warning: Changing network settings may require a reboot and could affect connectivity.
                </p>
            </div>

            <!-- Security Configuration Section -->
            <div class="section">
                <h2>Security Configuration
                    <button class="btn btn-primary btn-small" onclick="showEditSecurityModal()" style="float:right;">Edit Security</button>
                </h2>
                <div class="kv-grid">
                    <div class="info-label">Session Timeout:</div>
                    <div class="info-value" id="sec-timeout">-</div>
                </div>
            </div>

            <!-- Time/NTP Configuration Section -->
            <div class="section">
                <h2>Time & NTP Configuration
                    <button class="btn btn-success btn-small" onclick="forceNtpSync(event)" style="float:right; margin-right:10px;">ğŸ”„ Sync Now</button>
                    <button class="btn btn-primary btn-small" onclick="showEditTimeModal()" style="float:right; margin-right:10px;">Edit Time Settings</button>
                </h2>
                <div class="kv-grid">
                    <div class="info-label">NTP Server 1:</div>
                    <div class="info-value" id="time-ntp1">-</div>

                    <div class="info-label">NTP Server 2:</div>
                    <div class="info-value" id="time-ntp2">-</div>

                    <div class="info-label">Timezone:</div>
                    <div class="info-value" id="time-timezone">-</div>

                    <div class="info-label">Scheduled Sync:</div>
                    <div class="info-value" id="time-sync">-</div>

                    <div class="info-label">Current Time:</div>
                    <div class="info-value" id="time-current">-</div>
                </div>
                <p class="note-warn">
                    âš ï¸ Note: NTP and timezone changes require a reboot to apply.
                </p>
            </div>

            <!-- MQTT Configuration Section -->
            <div class="section">
                <h2>MQTT Configuration
                    <button class="btn btn-primary btn-small" onclick="showEditMqttModal()" style="float:right;">Edit MQTT Settings</button>
                </h2>
                <div class="kv-grid">
                    <div class="info-label">MQTT Enabled:</div>
                    <div class="info-value" id="mqtt-enabled">-</div>

                    <div class="info-label">Broker URI:</div>
                    <div class="info-value" id="mqtt-broker-uri">-</div>

                    <div class="info-label">Username:</div>
                    <div class="info-value" id="mqtt-username">-</div>

                    <div class="info-label">Password:</div>
                    <div class="info-value" id="mqtt-password">-</div>

                    <div class="info-label">Client ID:</div>
                    <div class="info-value" id="mqtt-client-id">-</div>

                    <div class="info-label">Base Topic:</div>
                    <div class="info-value" id="mqtt-base-topic">-</div>

                    <div class="info-label">Home Assistant Discovery:</div>
                    <div class="info-value" id="mqtt-ha-discovery">-</div>

                    <div class="info-label">QoS Level:</div>
                    <div class="info-value" id="mqtt-qos">-</div>

                    <div class="info-label">Retain Messages:</div>
                    <div class="info-value" id="mqtt-retain">-</div>
                </div>
                <p class="note-warn">
                    âš ï¸ Note: Changes to MQTT settings require restarting the MQTT client or rebooting the device.
                </p>
            </div>

            <!-- Panel Connection Section -->
            <div class="section">
                <h2>Panel Connection
                    <button class="btn btn-primary btn-small" onclick="showEditPanelModal()" style="float:right;">Edit Panel Connection</button>
                </h2>
                <div class="kv-grid">
                    <div class="info-label">Transport:</div>
                    <div class="info-value" id="panel-mode">-</div>

                    <div class="info-label">UART TX GPIO:</div>
                    <div class="info-value" id="panel-tx-gpio">-</div>

                    <div class="info-label">UART RX GPIO:</div>
                    <div class="info-value" id="panel-rx-gpio">-</div>

                    <div class="info-label">UART Baud:</div>
                    <div class="info-value" id="panel-baud">-</div>

                    <div class="info-label">UDP Panel:</div>
                    <div class="info-value" id="panel-udp">-</div>
                </div>
                <p class="note-warn">
                    âš ï¸ Note: Changing the panel transport reboots the device. UART mode wires
                    the panel's 3.3V TTL serial port directly to these GPIO pins (no level
                    shifter needed). Do not use GPIO37/38 (console) or GPIO0 (boot button).
                    UDP mode talks to a network-reachable panel at the configured IP and port.
                </p>
            </div>

            <!-- System Actions Section -->
            <!-- Certificate Management Section -->
            <div class="section">
                <h2>ğŸ”’ Certificate Management (HTTPS/TLS)</h2>
                <p class="note-dim">
                    Manage TLS/SSL certificates for HTTPS encryption. Update certificates without reflashing firmware.
                </p>

                <!-- Current Certificate Info -->
                <div class="subcard">
                    <h3>Current Certificate</h3>
                    <div class="kv-grid">
                        <div class="info-label">Source:</div>
                        <div class="info-value" id="cert-source">Loading...</div>

                        <div class="info-label">Subject:</div>
                        <div class="info-value" id="cert-subject">-</div>

                        <div class="info-label">Valid From:</div>
                        <div class="info-value" id="cert-not-before">-</div>

                        <div class="info-label">Valid Until:</div>
                        <div class="info-value" id="cert-not-after">-</div>

                        <div class="info-label">Type:</div>
                        <div class="info-value" id="cert-type">-</div>

                        <div class="info-label">Size:</div>
                        <div class="info-value" id="cert-size">-</div>
                    </div>
                    <button class="btn btn-secondary" onclick="refreshCertInfo()" style="margin-top:10px;">Refresh Info</button>
                </div>

                <!-- Certificate Actions -->
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:15px;">
                    <button class="btn btn-primary" onclick="showGenerateCertModal()">
                        âš™ï¸ Generate Certificate (On-Device)
                    </button>
                    <button class="btn btn-primary" onclick="showUploadCertModal()">
                        ğŸ“¤ Upload Certificate
                    </button>
                </div>

                <button class="btn btn-secondary" onclick="showDeleteCertModal()" style="background:#d32f2f;">
                    ğŸ—‘ï¸ Delete Runtime Certificate (Revert to Embedded)
                </button>

                <div style="margin-top:15px; padding:10px; background:rgba(255,193,7,0.1); border:1px solid #ffc107; border-radius:4px;">
                    <strong style="color:#ffc107;">âš ï¸ Important:</strong>
                    <span> After generating or uploading a certificate, you must <strong>reboot</strong> the device to apply changes.</span>
                </div>
            </div>

            <div class="section">
                <h2>System Actions</h2>
                <p class="note-dim">
                    Reboot the device to apply configuration changes or resolve connectivity issues.
                </p>
                <button class="btn btn-primary" onclick="showRebootModal()">Reboot Device</button>
            </div>

            <!-- Danger Zone Section -->
            <div class="section" style="border-color:#d32f2f;">
                <h2 style="color:#ff6b6b;">Danger Zone</h2>
                <p class="note-dim">
                    Factory reset will erase ALL user accounts, settings, and return to defaults (admin/admin).
                    The device will reboot automatically.
                </p>
                <button class="btn btn-danger" onclick="showFactoryResetModal()">Factory Reset</button>
            </div>
        </div>
    </div>

    <!-- Add User Modal -->
    <div id="add-user-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">Add New User</div>
            <div class="form-group">
                <label>Username</label>
                <input type="text" id="new-username" placeholder="Enter username">
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" id="new-password" placeholder="Enter password">
            </div>
            <div class="form-group">
                <label>Role</label>
                <select id="new-role">
                    <option value="viewer">Viewer (Read-only)</option>
                    <option value="admin">Admin (Full access)</option>
                </select>
            </div>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('add-user-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-primary" onclick="createUser()">Create User</button>
            </div>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div id="change-password-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">Change Password for <span id="change-pass-username"></span></div>
            <div class="form-group">
                <label>New Password</label>
                <input type="password" id="change-password" placeholder="Enter new password">
            </div>
            <div style="color:#888; font-size:12px; margin-bottom:15px;">
                Password must be at least 8 characters with uppercase, lowercase, digit, and special character.
            </div>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('change-password-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-primary" onclick="changeUserPassword()">Change Password</button>
            </div>
        </div>
    </div>

    <!-- Reboot Modal -->
    <div id="reboot-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">Confirm Reboot</div>
            <p class="note-dim">
                The device will reboot immediately. This may be necessary to apply network, NTP, or timezone configuration changes.
            </p>
            <p style="color:#ffa726; margin-bottom:15px;">
                You will be disconnected and will need to log in again after the device restarts.
            </p>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('reboot-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-primary" onclick="performReboot()">Reboot Now</button>
            </div>
        </div>
    </div>

    <!-- Factory Reset Modal -->
    <div id="factory-reset-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header" style="color:#ff6b6b;">Confirm Factory Reset</div>
            <p class="note-dim">
                This will permanently erase ALL user accounts and settings. The device will reboot with default credentials (admin/admin).
            </p>
            <p style="color:#ff6b6b; margin-bottom:15px; font-weight:bold;">
                This action CANNOT be undone!
            </p>
            <div class="form-group">
                <label>Type "FACTORY_RESET" to confirm</label>
                <input type="text" id="factory-reset-confirm" placeholder="FACTORY_RESET">
            </div>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('factory-reset-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-danger" onclick="performFactoryReset()">Reset Device</button>
            </div>
        </div>
    </div>

    <!-- Generate Certificate Modal -->
    <div id="generate-cert-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">Generate Certificate On-Device</div>
            <p style="color:#ffc107; margin-bottom:15px;">
                âš ï¸ This will take approximately 30 seconds to complete.
            </p>
            <div class="form-group">
                <label>Common Name (CN)</label>
                <input type="text" id="gen-common-name" placeholder="orisec-gateway.local" value="orisec-gateway.local">
            </div>
            <div class="form-group">
                <label>Organization (O)</label>
                <input type="text" id="gen-organization" placeholder="Orisec Gateway" value="Orisec Gateway">
            </div>
            <div class="form-group">
                <label>Country (C)</label>
                <input type="text" id="gen-country" placeholder="GB" value="GB" maxlength="2">
            </div>
            <div class="form-group">
                <label>Validity (days)</label>
                <input type="number" id="gen-validity-days" placeholder="3650" value="3650" min="1" max="36500">
            </div>
            <p style="color:#888; font-size:14px; margin-bottom:15px;">
                After generation completes, you must reboot the device to use the new certificate.
            </p>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('generate-cert-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-primary" onclick="generateCertificate()">Generate (~30s)</button>
            </div>
            <div id="gen-cert-status" style="margin-top:15px;"></div>
        </div>
    </div>

    <!-- Upload Certificate Modal -->
    <div id="upload-cert-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">Upload Certificate</div>
            <p class="note-dim">
                Upload a PEM-format certificate and private key. Supports self-signed or CA-signed certificates (e.g., Let's Encrypt).
            </p>
            <div class="form-group">
                <label>Certificate (PEM format)</label>
                <textarea id="upload-certificate" placeholder="-----BEGIN CERTIFICATE-----&#10;MIID...&#10;-----END CERTIFICATE-----" rows="8" style="font-family:monospace; font-size:12px;"></textarea>
            </div>
            <div class="form-group">
                <label>Private Key (PEM format)</label>
                <textarea id="upload-private-key" placeholder="-----BEGIN PRIVATE KEY-----&#10;MIIE...&#10;-----END PRIVATE KEY-----" rows="8" style="font-family:monospace; font-size:12px;"></textarea>
            </div>
            <p style="color:#888; font-size:14px; margin-bottom:15px;">
                After upload completes, you must reboot the device to use the new certificate.
            </p>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('upload-cert-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-primary" onclick="uploadCertificate()">Upload Certificate</button>
            </div>
            <div id="upload-cert-status" style="margin-top:15px;"></div>
        </div>
    </div>

    <!-- Delete Certificate Modal -->
    <div id="delete-cert-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header" style="color:#ff6b6b;">Delete Runtime Certificate</div>
            <p class="note-dim">
                This will delete the uploaded/generated certificate from storage. The device will revert to the embedded firmware certificate on next reboot.
            </p>
            <p style="color:#ffc107; margin-bottom:15px;">
                You must reboot after deletion to apply changes.
            </p>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('delete-cert-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-danger" onclick="deleteCertificate()">Delete Certificate</button>
            </div>
        </div>
    </div>

    <!-- Edit Network Configuration Modal -->
    <div id="edit-network-modal" class="modal">
        <div class="modal-content">
            <h2>Edit Network Configuration</h2>
            <div class="form-group">
                <label>
                    <input type="checkbox" id="edit-use-dhcp" onchange="toggleStaticIPFields()">
                    Use DHCP (automatic IP)
                </label>
            </div>
            <div id="static-ip-fields">
                <div class="form-group">
                    <label>Static IP Address</label>
                    <input type="text" id="edit-static-ip" placeholder="192.168.1.100">
                </div>
                <div class="form-group">
                    <label>Netmask</label>
                    <input type="text" id="edit-netmask" placeholder="255.255.255.0">
                </div>
                <div class="form-group">
                    <label>Gateway</label>
                    <input type="text" id="edit-gateway" placeholder="192.168.1.1">
                </div>
            </div>
            <div class="form-group">
                <label>Primary DNS Server</label>
                <input type="text" id="edit-dns-primary" placeholder="8.8.8.8">
            </div>
            <div class="form-group">
                <label>Secondary DNS Server</label>
                <input type="text" id="edit-dns-secondary" placeholder="8.8.4.4">
            </div>
            <div class="form-group">
                <label>Hostname</label>
                <input type="text" id="edit-hostname" placeholder="orisec-gateway">
            </div>
            <div class="form-group">
                <label>HTTP Port</label>
                <input type="number" id="edit-http-port" min="1" max="65535" placeholder="8080">
            </div>
            <p style="color:#ffa726; font-size:13px; margin-top:10px;">
                âš ï¸ Device will reboot after saving. You may need to reconnect at the new IP/port.
            </p>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('edit-network-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-primary" onclick="saveNetworkConfig()">Save & Reboot</button>
            </div>
        </div>
    </div>

    <!-- Edit Security Configuration Modal -->
    <div id="edit-security-modal" class="modal">
        <div class="modal-content">
            <h2>Edit Security Configuration</h2>
            <div class="form-group">
                <label>Session Timeout (minutes)</label>
                <input type="number" id="edit-session-timeout" min="1" max="1440" placeholder="15">
                <p style="color:#888; font-size:12px; margin-top:5px;">
                    How long users stay logged in without activity (1-1440 minutes)
                </p>
            </div>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('edit-security-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-primary" onclick="saveSecurityConfig()">Save</button>
            </div>
        </div>
    </div>

    <!-- Edit Time/NTP Configuration Modal -->
    <div id="edit-time-modal" class="modal">
        <div class="modal-content">
            <h2>Edit Time & NTP Configuration</h2>
            <div class="form-group">
                <label>Primary NTP Server</label>
                <input type="text" id="edit-ntp1" placeholder="pool.ntp.org">
            </div>
            <div class="form-group">
                <label>Secondary NTP Server</label>
                <input type="text" id="edit-ntp2" placeholder="time.google.com">
            </div>
            <div class="form-group">
                <label>Timezone</label>
                <select id="edit-tz-select" onchange="onTzSelect()">
                    <option value="UTC0">UTC â€” Coordinated Universal Time</option>
                    <optgroup label="Europe">
                        <option value="GMT0BST,M3.5.0/1,M10.5.0">United Kingdom â€” London (GMT / BST)</option>
                        <option value="GMT0IST,M3.5.0/1,M10.5.0">Ireland â€” Dublin (GMT / IST)</option>
                        <option value="WET0WEST,M3.5.0/1,M10.5.0">Portugal â€” Lisbon (WET / WEST)</option>
                        <option value="CET-1CEST,M3.5.0,M10.5.0/3">Central Europe â€” Paris, Berlin, Madrid, Rome (CET / CEST)</option>
                        <option value="EET-2EEST,M3.5.0/3,M10.5.0/4">Eastern Europe â€” Athens, Helsinki (EET / EEST)</option>
                        <option value="MSK-3">Russia â€” Moscow (MSK, no DST)</option>
                    </optgroup>
                    <optgroup label="Americas">
                        <option value="AST4ADT,M3.2.0,M11.1.0">Canada Atlantic â€” Halifax (AST / ADT)</option>
                        <option value="EST5EDT,M3.2.0,M11.1.0">US &amp; Canada Eastern â€” New York, Toronto (EST / EDT)</option>
                        <option value="CST6CDT,M3.2.0,M11.1.0">US &amp; Canada Central â€” Chicago (CST / CDT)</option>
                        <option value="MST7MDT,M3.2.0,M11.1.0">US &amp; Canada Mountain â€” Denver (MST / MDT)</option>
                        <option value="MST7">US Mountain â€” Arizona (MST, no DST)</option>
                        <option value="PST8PDT,M3.2.0,M11.1.0">US &amp; Canada Pacific â€” Los Angeles (PST / PDT)</option>
                        <option value="AKST9AKDT,M3.2.0,M11.1.0">US Alaska â€” Anchorage (AKST / AKDT)</option>
                        <option value="HST10">US Hawaii â€” Honolulu (HST, no DST)</option>
                        <option value="BRT3">Brazil â€” SÃ£o Paulo (BRT, no DST)</option>
                    </optgroup>
                    <optgroup label="Asia &amp; Middle East">
                        <option value="GST-4">Gulf â€” Dubai, Abu Dhabi (GST, no DST)</option>
                        <option value="IST-5:30">India â€” Mumbai, New Delhi (IST, no DST)</option>
                        <option value="ICT-7">Southeast Asia â€” Bangkok, Jakarta (ICT, no DST)</option>
                        <option value="CST-8">China / Hong Kong / Singapore (no DST)</option>
                        <option value="JST-9">Japan â€” Tokyo (JST, no DST)</option>
                    </optgroup>
                    <optgroup label="Oceania">
                        <option value="AWST-8">Australia Western â€” Perth (AWST, no DST)</option>
                        <option value="ACST-9:30ACDT,M10.1.0,M4.1.0/3">Australia Central â€” Adelaide (ACST / ACDT)</option>
                        <option value="AEST-10AEDT,M10.1.0,M4.1.0/3">Australia Eastern â€” Sydney, Melbourne (AEST / AEDT)</option>
                        <option value="AEST-10">Australia â€” Brisbane (AEST, no DST)</option>
                        <option value="NZST-12NZDT,M9.5.0,M4.1.0/3">New Zealand â€” Auckland (NZST / NZDT)</option>
                    </optgroup>
                    <option value="__custom__">Custom (POSIX TZ string)â€¦</option>
                </select>
                <div id="tz-custom-wrap" style="display:none; margin-top:10px;">
                    <input type="text" id="edit-timezone" placeholder="GMT0BST,M3.5.0/1,M10.5.0">
                    <p style="color:var(--dim); font-size:12px; margin-top:5px;">
                        Advanced: a raw POSIX TZ string (daylight-saving rules are part of the string).
                        Examples: "GMT0BST,M3.5.0/1,M10.5.0" (UK), "EST5EDT,M3.2.0,M11.1.0" (US Eastern).
                    </p>
                </div>
                <p style="color:var(--dim); font-size:12px; margin-top:5px;">
                    Daylight saving is applied automatically for zones that observe it.
                </p>
            </div>
            <div class="form-group">
                <label>
                    <input type="checkbox" id="edit-sync-enabled" onchange="toggleSyncTimeFields()">
                    Enable Scheduled Panel Time Sync
                </label>
            </div>
            <div id="sync-time-fields" style="display:none;">
                <div class="form-group">
                    <label>Sync Hour (0-23)</label>
                    <input type="number" id="edit-sync-hour" min="0" max="23" placeholder="3">
                </div>
                <div class="form-group">
                    <label>Sync Minute (0-59)</label>
                    <input type="number" id="edit-sync-minute" min="0" max="59" placeholder="0">
                </div>
                <p style="color:#888; font-size:12px;">
                    Panel time will be synchronized daily at the specified time (e.g., 03:00 = 3:00 AM)
                </p>
            </div>
            <p style="color:#ffa726; font-size:13px; margin-top:10px;">
                âš ï¸ NTP and timezone changes require a reboot to apply.
            </p>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('edit-time-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-primary" onclick="saveTimeConfig()">Save</button>
            </div>
        </div>
    </div>

    <!-- Edit MQTT Configuration Modal -->
    <div id="edit-mqtt-modal" class="modal">
        <div class="modal-content" style="max-width:700px;">
            <h2>Edit MQTT Configuration</h2>
            <div class="form-group">
                <label>
                    <input type="checkbox" id="edit-mqtt-enabled">
                    Enable MQTT Client
                </label>
            </div>
            <div class="form-group">
                <label>Broker URI</label>
                <input type="text" id="edit-mqtt-broker-uri" placeholder="mqtt://192.168.0.100:1883">
                <p style="color:#888; font-size:12px; margin-top:5px;">
                    Examples: mqtt://broker:1883, mqtts://broker:8883 (SSL)
                </p>
            </div>
            <div class="form-group">
                <label>Username (optional)</label>
                <input type="text" id="edit-mqtt-username" placeholder="Leave empty if no authentication">
            </div>
            <div class="form-group">
                <label>Password (optional)</label>
                <input type="password" id="edit-mqtt-password" placeholder="Leave empty if no authentication">
            </div>
            <div class="form-group">
                <label>Client ID</label>
                <input type="text" id="edit-mqtt-client-id" placeholder="orisec-gateway">
                <p style="color:#888; font-size:12px; margin-top:5px;">
                    Unique identifier for this MQTT client
                </p>
            </div>
            <div class="form-group">
                <label>Base Topic</label>
                <input type="text" id="edit-mqtt-base-topic" placeholder="orisec">
                <p style="color:#888; font-size:12px; margin-top:5px;">
                    All MQTT messages will be published under this topic prefix
                </p>
            </div>
            <div class="form-group">
                <label>
                    <input type="checkbox" id="edit-mqtt-ha-discovery">
                    Enable Home Assistant MQTT Discovery
                </label>
                <p style="color:#888; font-size:12px; margin-top:5px;">
                    Automatically configures entities in Home Assistant
                </p>
            </div>
            <div class="form-group">
                <label>QoS Level</label>
                <select id="edit-mqtt-qos">
                    <option value="0">0 - At most once (fastest)</option>
                    <option value="1">1 - At least once (recommended)</option>
                    <option value="2">2 - Exactly once (slowest)</option>
                </select>
            </div>
            <div class="form-group">
                <label>
                    <input type="checkbox" id="edit-mqtt-retain">
                    Retain State Messages
                </label>
                <p style="color:#888; font-size:12px; margin-top:5px;">
                    New MQTT clients will receive the last known state immediately
                </p>
            </div>
            <p style="color:#ffa726; font-size:13px; margin-top:10px;">
                âš ï¸ Restart the MQTT client or reboot the device after saving for changes to apply.
            </p>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('edit-mqtt-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-primary" onclick="saveMqttConfig()">Save</button>
            </div>
        </div>
    </div>

    <!-- Edit Panel Connection Modal -->
    <div id="edit-panel-modal" class="modal">
        <div class="modal-content" style="max-width:600px;">
            <h2>Edit Panel Connection</h2>
            <div class="form-group">
                <label>Transport Mode</label>
                <select id="edit-panel-mode" onchange="togglePanelUartFields()">
                    <option value="usb">USB Host (CDC-ACM adapter)</option>
                    <option value="uart">Onboard UART (onboard GPIO)</option>
                    <option value="udp">UDP (network-reachable panel)</option>
                </select>
            </div>
            <div id="panel-udp-fields">
                <div class="form-group">
                    <label>Panel IP Address</label>
                    <input type="text" id="edit-panel-udp-ip" placeholder="192.168.0.50">
                    <p style="color:#888; font-size:12px; margin-top:5px;">
                        IPv4 address of the panel's UDP interface.
                    </p>
                </div>
                <div class="form-group">
                    <label>Remote Port (panel)</label>
                    <input type="number" id="edit-panel-udp-remote-port" min="1" max="65535" placeholder="10001">
                    <p style="color:#888; font-size:12px; margin-top:5px;">
                        Port on the panel the gateway sends commands to.
                    </p>
                </div>
                <div class="form-group">
                    <label>Local Port (gateway)</label>
                    <input type="number" id="edit-panel-udp-local-port" min="0" max="65535" placeholder="10001">
                    <p style="color:#888; font-size:12px; margin-top:5px;">
                        Port the gateway binds to receive panel data. Set to match the
                        panel's configured destination port. Use 0 for an ephemeral port
                        (only works if the panel replies to the command source port).
                    </p>
                </div>
            </div>
            <div id="panel-uart-fields">
                <div class="form-group">
                    <label>UART TX GPIO</label>
                    <input type="number" id="edit-panel-tx-gpio" min="0" max="56" placeholder="32">
                    <p style="color:#888; font-size:12px; margin-top:5px;">
                        ESP32-P4-NANO: GPIO32/33 are free. Avoid GPIO37/38 (console) and GPIO0 (boot).
                    </p>
                </div>
                <div class="form-group">
                    <label>UART RX GPIO</label>
                    <input type="number" id="edit-panel-rx-gpio" min="0" max="56" placeholder="33">
                </div>
                <div class="form-group">
                    <label>Baud Rate</label>
                    <input type="number" id="edit-panel-baud" min="1200" max="115200" placeholder="9600">
                    <p style="color:#888; font-size:12px; margin-top:5px;">
                        Orisec panels use 9600 8N1.
                    </p>
                </div>
            </div>
            <p style="color:#ffa726; font-size:13px; margin-top:10px;">
                âš ï¸ Saving reboots the device to switch the serial backend. UART mode connects
                these 3.3V TTL GPIO pins directly to the panel's serial port (no level shifter needed).
            </p>
            <div class="form-actions">
                <button class="btn" onclick="closeModal('edit-panel-modal')" style="background:#666;">Cancel</button>
                <button class="btn btn-primary" onclick="savePanelConfig()">Save &amp; Reboot</button>
            </div>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('auth_token');
        const username = localStorage.getItem('auth_username');

        if (!token) {
            window.location.href = '/ui/login';
        }

        // Helper to add auth header to fetch calls and handle session expiry
        async function authFetch(url, options = {}) {
            options.headers = options.headers || {};
            options.headers['Authorization'] = 'Bearer ' + token;
            const response = await fetch(url, options);
            console.log('[authFetch]', url, 'status:', response.status);
            if (response.status === 401) {
                console.warn('[authFetch] Session expired! Logging out and redirecting to login');
                localStorage.clear();
                window.location.href = '/ui/login';
                throw new Error('Session expired');
            }
            return response;
        }

        async function loadSettings() {
            try {
                // Load current user info
                document.getElementById('current-username').textContent = username || '-';
                const role = localStorage.getItem('auth_role');
                document.getElementById('current-role').textContent = role || '-';

                // Load users list
                const usersResp = await authFetch('/api/users');
                const usersData = await usersResp.json();
                if (usersData.ok) {
                    displayUsers(usersData.users);
                }

                // Load network config
                const netResp = await authFetch('/api/config/network');
                const netData = await netResp.json();
                if (netData.ok) {
                    displayNetworkConfig(netData.config, netData.active);
                }

                // Load security config
                const secResp = await authFetch('/api/config/security');
                const secData = await secResp.json();
                if (secData.ok) {
                    displaySecurityConfig(secData.config);
                }

                // Load time config
                const timeResp = await authFetch('/api/config/time');
                const timeData = await timeResp.json();
                if (timeData.ok) {
                    displayTimeConfig(timeData.config);
                }

                // Load MQTT config
                const mqttResp = await authFetch('/api/config/mqtt');
                const mqttData = await mqttResp.json();
                if (mqttData.ok) {
                    displayMqttConfig(mqttData.config);
                }

                // Load panel transport config
                const panelResp = await authFetch('/api/config/panel');
                const panelData = await panelResp.json();
                if (panelData.ok) {
                    displayPanelConfig(panelData.config);
                }

                // Load certificate info
                await loadCertificateInfo();

                document.getElementById('loading').style.display = 'none';
                document.getElementById('content').style.display = 'block';

                // Update current time every second
                setInterval(updateCurrentTime, 1000);

            } catch (error) {
                showError('Failed to load settings: ' + error.message);
                document.getElementById('loading').style.display = 'none';
            }
        }

        function displayUsers(users) {
            const container = document.getElementById('users-list');
            container.innerHTML = '';

            users.forEach(user => {
                const card = document.createElement('div');
                card.className = 'user-card';
                const isCurrentUser = user.username === username;
                card.innerHTML = `
                    <div class="user-info">
                        <strong>${user.username}</strong>
                        <span class="user-role role-${user.role}">${user.role.toUpperCase()}</span>
                        ${isCurrentUser ? '<span style="color:#888; font-size:12px; margin-left:10px;">(You)</span>' : ''}
                    </div>
                    <div>
                        <button class="btn btn-primary btn-small" onclick="showChangePasswordModal('${user.username}')">Change Password</button>
                        ${!isCurrentUser ? `<button class="btn btn-danger btn-small" onclick="deleteUser('${user.username}')">Delete</button>` : ''}
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function displayNetworkConfig(config, active) {
            currentNetworkConfig = config; // Store for editing
            const isDHCP = config.use_dhcp;

            document.getElementById('net-mode').textContent = isDHCP ? 'DHCP' : 'Static';

            // When DHCP is enabled, show active (assigned) values in grey
            // When Static is enabled, show configured values normally
            if (isDHCP && active) {
                // Show DHCP-assigned values
                document.getElementById('net-ip').innerHTML = `<span>${active.ip}</span> <span class="kv-tag">(DHCP)</span>`;
                document.getElementById('net-netmask').innerHTML = `<span>${active.netmask}</span> <span class="kv-tag">(DHCP)</span>`;
                document.getElementById('net-gateway').innerHTML = `<span>${active.gateway}</span> <span class="kv-tag">(DHCP)</span>`;
                document.getElementById('net-dns-primary').innerHTML = `<span>${active.dns_primary || '-'}</span> <span class="kv-tag">(DHCP)</span>`;
                document.getElementById('net-dns-secondary').innerHTML = `<span>${active.dns_secondary || '-'}</span> <span class="kv-tag">(DHCP)</span>`;
            } else {
                // Show static configured values
                document.getElementById('net-ip').textContent = config.static_ip;
                document.getElementById('net-netmask').textContent = config.netmask;
                document.getElementById('net-gateway').textContent = config.gateway;
                document.getElementById('net-dns-primary').textContent = config.dns_primary || '-';
                document.getElementById('net-dns-secondary').textContent = config.dns_secondary || '-';
            }

            // These are always from config (not affected by DHCP)
            document.getElementById('net-hostname').textContent = config.hostname;
            document.getElementById('net-port').textContent = config.http_port;
        }

        let currentSecurityConfig = null;

        function displaySecurityConfig(config) {
            currentSecurityConfig = config; // Store for editing
            const minutes = Math.floor(config.session_timeout_sec / 60);
            document.getElementById('sec-timeout').textContent =
                config.session_timeout_sec + ' seconds (' + minutes + ' minutes)';
        }

        let currentTimeConfig = null;

        function displayTimeConfig(config) {
            currentTimeConfig = config; // Store for editing
            document.getElementById('time-ntp1').textContent = config.ntp_server1;
            document.getElementById('time-ntp2').textContent = config.ntp_server2;
            document.getElementById('time-timezone').textContent = config.timezone;

            if (config.sync_hour === 255) {
                document.getElementById('time-sync').textContent = 'Disabled';
            } else {
                const hourStr = String(config.sync_hour).padStart(2, '0');
                const minStr = String(config.sync_minute).padStart(2, '0');
                document.getElementById('time-sync').textContent = 'Daily at ' + hourStr + ':' + minStr;
            }

            // Update current time
            updateCurrentTime();
        }

        function updateCurrentTime() {
            const now = new Date();
            const timeStr = now.toLocaleString('en-GB', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hour12: false
            });
            document.getElementById('time-current').textContent = timeStr;
        }

        async function forceNtpSync(event) {
            const btn = event.target;
            const originalText = btn.textContent;

            btn.disabled = true;
            btn.textContent = 'â³ Syncing...';

            try {
                const response = await authFetch('/api/force-ntp-sync', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await response.json();

                if (data.ok) {
                    alert('âœ… ' + data.message + '\nNew time: ' + data.datetime);
                    updateCurrentTime();
                } else {
                    alert('âŒ ' + (data.error || 'NTP sync failed'));
                }
            } catch (error) {
                alert('âŒ Network error: ' + error.message);
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        }

        function showError(msg) {
            const errorDiv = document.getElementById('error');
            errorDiv.textContent = msg;
            errorDiv.style.display = 'block';
        }

        // Modal management
        function showModal(modalId) {
            document.getElementById(modalId).classList.add('show');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('show');
            // Clear form inputs
            const modal = document.getElementById(modalId);
            const inputs = modal.querySelectorAll('input');
            inputs.forEach(input => input.value = '');
        }

        // User management functions
        let selectedUsername = null;

        function showAddUserModal() {
            showModal('add-user-modal');
        }

        function showChangePasswordModal(username) {
            selectedUsername = username;
            document.getElementById('change-pass-username').textContent = username;
            showModal('change-password-modal');
        }

        async function createUser() {
            const username = document.getElementById('new-username').value.trim();
            const password = document.getElementById('new-password').value;
            const role = document.getElementById('new-role').value;

            if (!username || !password) {
                showError('Username and password are required');
                return;
            }

            try {
                const response = await authFetch('/api/users/create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ username, password, role })
                });

                const data = await response.json();

                if (data.ok) {
                    closeModal('add-user-modal');
                    loadSettings(); // Reload to show new user
                } else {
                    showError(data.error || 'Failed to create user');
                }
            } catch (error) {
                showError('Network error: ' + error.message);
            }
        }

        async function changeUserPassword() {
            const newPassword = document.getElementById('change-password').value;

            if (!newPassword) {
                showError('Password is required');
                return;
            }

            try {
                const response = await authFetch('/api/users/change-password', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        username: selectedUsername,
                        new_password: newPassword
                    })
                });

                const data = await response.json();

                if (data.ok) {
                    closeModal('change-password-modal');
                    alert('Password changed successfully');
                } else {
                    showError(data.error || 'Failed to change password');
                }
            } catch (error) {
                showError('Network error: ' + error.message);
            }
        }

        async function deleteUser(username) {
            if (!confirm(`Delete user "${username}"? This cannot be undone.`)) {
                return;
            }

            try {
                const response = await authFetch('/api/users/delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ username })
                });

                const data = await response.json();

                if (data.ok) {
                    loadSettings(); // Reload to remove deleted user
                } else {
                    showError(data.error || 'Failed to delete user');
                }
            } catch (error) {
                showError('Network error: ' + error.message);
            }
        }

        // Reboot
        function showRebootModal() {
            showModal('reboot-modal');
        }

        async function performReboot() {
            try {
                const response = await authFetch('/api/reboot', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const data = await response.json();

                if (data.ok) {
                    closeModal('reboot-modal');
                    alert('Device is rebooting... You will be redirected to the login page.');
                    localStorage.clear();
                    setTimeout(() => {
                        window.location.href = '/ui/login';
                    }, 3000);
                } else {
                    showError(data.error || 'Reboot failed');
                }
            } catch (error) {
                // Network error is expected during reboot
                closeModal('reboot-modal');
                alert('Device is rebooting... You will be redirected to the login page.');
                localStorage.clear();
                setTimeout(() => {
                    window.location.href = '/ui/login';
                }, 5000);
            }
        }

        // Factory reset
        function showFactoryResetModal() {
            showModal('factory-reset-modal');
        }

        async function performFactoryReset() {
            const confirmation = document.getElementById('factory-reset-confirm').value;

            if (confirmation !== 'FACTORY_RESET') {
                showError('You must type "FACTORY_RESET" to confirm');
                return;
            }

            try {
                const response = await authFetch('/api/factory-reset', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ confirm: 'FACTORY_RESET' })
                });

                const data = await response.json();

                if (data.ok) {
                    alert('Factory reset initiated. Device will reboot...');
                    setTimeout(() => {
                        window.location.href = '/ui/login';
                    }, 3000);
                } else {
                    showError(data.error || 'Factory reset failed');
                }
            } catch (error) {
                // Network error is expected during reboot
                alert('Factory reset initiated. Device is rebooting...');
                setTimeout(() => {
                    window.location.href = '/ui/login';
                }, 5000);
            }
        }

        // Certificate Management Functions
        async function loadCertificateInfo() {
            try {
                const resp = await authFetch('/api/certificate/info');
                const data = await resp.json();
                if (data.ok) {
                    document.getElementById('cert-source').textContent = data.source;
                    document.getElementById('cert-subject').textContent = data.subject;
                    document.getElementById('cert-not-before').textContent = data.not_before;
                    document.getElementById('cert-not-after').textContent = data.not_after;
                    document.getElementById('cert-type').textContent = data.is_self_signed ? 'Self-Signed' : 'CA-Signed';
                    document.getElementById('cert-size').textContent = `${data.cert_size} bytes (cert) + ${data.key_size} bytes (key)`;
                } else {
                    document.getElementById('cert-source').textContent = 'Error loading certificate info';
                }
            } catch (error) {
                console.error('Failed to load certificate info:', error);
                document.getElementById('cert-source').textContent = 'Failed to load';
            }
        }

        async function refreshCertInfo() {
            document.getElementById('cert-source').textContent = 'Loading...';
            await loadCertificateInfo();
        }

        function showGenerateCertModal() {
            document.getElementById('gen-cert-status').innerHTML = '';
            showModal('generate-cert-modal');
        }

        async function generateCertificate() {
            const commonName = document.getElementById('gen-common-name').value.trim();
            const organization = document.getElementById('gen-organization').value.trim();
            const country = document.getElementById('gen-country').value.trim();
            const validityDays = parseInt(document.getElementById('gen-validity-days').value);

            if (!commonName || !organization || !country || !validityDays) {
                document.getElementById('gen-cert-status').innerHTML =
                    '<p style="color:#ff6b6b;">Please fill in all fields</p>';
                return;
            }

            if (country.length !== 2) {
                document.getElementById('gen-cert-status').innerHTML =
                    '<p style="color:#ff6b6b;">Country code must be 2 letters (e.g., GB, US)</p>';
                return;
            }

            document.getElementById('gen-cert-status').innerHTML =
                '<p style="color:#ffc107;">â³ Generating certificate... This will take approximately 30 seconds.</p>';

            try {
                const resp = await authFetch('/api/certificate/generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        common_name: commonName,
                        organization: organization,
                        country: country,
                        validity_days: validityDays
                    })
                });

                const data = await resp.json();
                if (data.ok) {
                    document.getElementById('gen-cert-status').innerHTML =
                        '<p style="color:#4caf50;">âœ“ Certificate generated successfully! Please reboot the device to apply.</p>';
                    setTimeout(() => {
                        closeModal('generate-cert-modal');
                        refreshCertInfo();
                    }, 3000);
                } else {
                    document.getElementById('gen-cert-status').innerHTML =
                        `<p style="color:#ff6b6b;">âœ— Generation failed: ${data.error || data.message}</p>`;
                }
            } catch (error) {
                document.getElementById('gen-cert-status').innerHTML =
                    `<p style="color:#ff6b6b;">âœ— Error: ${error.message}</p>`;
            }
        }

        function showUploadCertModal() {
            document.getElementById('upload-certificate').value = '';
            document.getElementById('upload-private-key').value = '';
            document.getElementById('upload-cert-status').innerHTML = '';
            showModal('upload-cert-modal');
        }

        async function uploadCertificate() {
            const certificate = document.getElementById('upload-certificate').value.trim();
            const privateKey = document.getElementById('upload-private-key').value.trim();

            if (!certificate || !privateKey) {
                document.getElementById('upload-cert-status').innerHTML =
                    '<p style="color:#ff6b6b;">Please provide both certificate and private key</p>';
                return;
            }

            if (!certificate.includes('BEGIN CERTIFICATE') || !privateKey.includes('BEGIN')) {
                document.getElementById('upload-cert-status').innerHTML =
                    '<p style="color:#ff6b6b;">Invalid PEM format. Ensure files start with -----BEGIN...</p>';
                return;
            }

            document.getElementById('upload-cert-status').innerHTML =
                '<p style="color:#ffc107;">â³ Uploading and validating certificate...</p>';

            try {
                const resp = await authFetch('/api/certificate/upload', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        certificate: certificate,
                        private_key: privateKey
                    })
                });

                const data = await resp.json();
                if (data.ok) {
                    document.getElementById('upload-cert-status').innerHTML =
                        '<p style="color:#4caf50;">âœ“ Certificate uploaded successfully! Please reboot the device to apply.</p>';
                    setTimeout(() => {
                        closeModal('upload-cert-modal');
                        refreshCertInfo();
                    }, 3000);
                } else {
                    document.getElementById('upload-cert-status').innerHTML =
                        `<p style="color:#ff6b6b;">âœ— Upload failed: ${data.error || data.message}</p>`;
                }
            } catch (error) {
                document.getElementById('upload-cert-status').innerHTML =
                    `<p style="color:#ff6b6b;">âœ— Error: ${error.message}</p>`;
            }
        }

        function showDeleteCertModal() {
            showModal('delete-cert-modal');
        }

        async function deleteCertificate() {
            try {
                const resp = await authFetch('/api/certificate/delete', {
                    method: 'POST'
                });

                const data = await resp.json();
                if (data.ok) {
                    closeModal('delete-cert-modal');
                    alert('Certificate deleted successfully. Please reboot to revert to embedded certificate.');
                    refreshCertInfo();
                } else {
                    alert('Failed to delete certificate: ' + (data.error || data.message));
                }
            } catch (error) {
                alert('Error deleting certificate: ' + error.message);
            }
        }

        // Network configuration
        let currentNetworkConfig = null;

        function showEditNetworkModal() {
            if (!currentNetworkConfig) {
                showError('Network configuration not loaded');
                return;
            }

            // Populate form with current values
            document.getElementById('edit-use-dhcp').checked = currentNetworkConfig.use_dhcp;
            document.getElementById('edit-static-ip').value = currentNetworkConfig.static_ip || '';
            document.getElementById('edit-netmask').value = currentNetworkConfig.netmask || '';
            document.getElementById('edit-gateway').value = currentNetworkConfig.gateway || '';
            document.getElementById('edit-dns-primary').value = currentNetworkConfig.dns_primary || '';
            document.getElementById('edit-dns-secondary').value = currentNetworkConfig.dns_secondary || '';
            document.getElementById('edit-hostname').value = currentNetworkConfig.hostname || '';
            document.getElementById('edit-http-port').value = currentNetworkConfig.http_port || 8080;

            toggleStaticIPFields();
            showModal('edit-network-modal');
        }

        function toggleStaticIPFields() {
            const useDhcp = document.getElementById('edit-use-dhcp').checked;
            const staticFields = document.getElementById('static-ip-fields');
            staticFields.style.display = useDhcp ? 'none' : 'block';
        }

        async function saveNetworkConfig() {
            const useDhcp = document.getElementById('edit-use-dhcp').checked;
            const staticIp = document.getElementById('edit-static-ip').value.trim();
            const netmask = document.getElementById('edit-netmask').value.trim();
            const gateway = document.getElementById('edit-gateway').value.trim();
            const dnsPrimary = document.getElementById('edit-dns-primary').value.trim();
            const dnsSecondary = document.getElementById('edit-dns-secondary').value.trim();
            const hostname = document.getElementById('edit-hostname').value.trim();
            const httpPort = parseInt(document.getElementById('edit-http-port').value);

            // Validation
            if (!hostname) {
                showError('Hostname is required');
                return;
            }

            if (!httpPort || httpPort < 1 || httpPort > 65535) {
                showError('HTTP port must be between 1 and 65535');
                return;
            }

            if (!useDhcp) {
                // Validate static IP fields
                if (!staticIp || !netmask || !gateway) {
                    showError('Static IP, netmask, and gateway are required when not using DHCP');
                    return;
                }

                // Basic IP validation (simple check)
                const ipPattern = /^(\d{1,3}\.){3}\d{1,3}$/;
                if (!ipPattern.test(staticIp) || !ipPattern.test(netmask) || !ipPattern.test(gateway)) {
                    showError('Invalid IP address format');
                    return;
                }
            }

            try {
                const response = await authFetch('/api/config/network', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        use_dhcp: useDhcp,
                        static_ip: useDhcp ? '' : staticIp,
                        netmask: useDhcp ? '' : netmask,
                        gateway: useDhcp ? '' : gateway,
                        dns_primary: dnsPrimary,
                        dns_secondary: dnsSecondary,
                        hostname: hostname,
                        http_port: httpPort
                    })
                });

                const data = await response.json();

                if (data.ok) {
                    // Build new URL with configured IP and port
                    const newUrl = useDhcp
                        ? window.location.protocol + '//' + window.location.hostname + ':' + httpPort + '/ui/login'
                        : window.location.protocol + '//' + staticIp + ':' + httpPort + '/ui/login';

                    alert('Network configuration saved. Device will reboot in 2 seconds...\\n\\n' +
                          'Redirecting to: ' + (useDhcp ? 'current hostname' : staticIp) + ':' + httpPort);

                    // Clear authentication (device will reboot)
                    localStorage.clear();

                    // Redirect to new address after brief delay
                    setTimeout(() => {
                        window.location.href = newUrl;
                    }, 2000);
                } else {
                    showError(data.error || 'Failed to save network configuration');
                }
            } catch (error) {
                // Network error is expected during reboot
                const newUrl = useDhcp
                    ? window.location.protocol + '//' + window.location.hostname + ':' + httpPort + '/ui/login'
                    : window.location.protocol + '//' + staticIp + ':' + httpPort + '/ui/login';

                alert('Network configuration saved. Device is rebooting...\\n\\n' +
                      'Redirecting to: ' + (useDhcp ? 'current hostname' : staticIp) + ':' + httpPort);

                localStorage.clear();

                setTimeout(() => {
                    window.location.href = newUrl;
                }, 3000);
            }
        }

        // Security configuration
        function showEditSecurityModal() {
            if (!currentSecurityConfig) {
                showError('Security configuration not loaded');
                return;
            }

            // Populate form with current value (convert seconds to minutes)
            const currentMinutes = Math.floor(currentSecurityConfig.session_timeout_sec / 60);
            document.getElementById('edit-session-timeout').value = currentMinutes;

            showModal('edit-security-modal');
        }

        async function saveSecurityConfig() {
            const timeoutMinutes = parseInt(document.getElementById('edit-session-timeout').value);

            // Validation
            if (!timeoutMinutes || timeoutMinutes < 1 || timeoutMinutes > 1440) {
                showError('Session timeout must be between 1 and 1440 minutes (24 hours)');
                return;
            }

            try {
                const response = await authFetch('/api/config/security', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        session_timeout_sec: timeoutMinutes * 60
                    })
                });

                const data = await response.json();

                if (data.ok) {
                    closeModal('edit-security-modal');
                    alert('Security configuration saved successfully');
                    loadSettings(); // Reload to show new values
                } else {
                    showError(data.error || 'Failed to save security configuration');
                }
            } catch (error) {
                showError('Network error: ' + error.message);
            }
        }

        // Time configuration
        function showEditTimeModal() {
            if (!currentTimeConfig) {
                showError('Time configuration not loaded');
                return;
            }

            // Populate form with current values
            document.getElementById('edit-ntp1').value = currentTimeConfig.ntp_server1 || '';
            document.getElementById('edit-ntp2').value = currentTimeConfig.ntp_server2 || '';

            // Timezone: match the stored POSIX string to a preset, else fall back to
            // the Custom option (revealing the raw text field pre-filled).
            const tz = currentTimeConfig.timezone || '';
            const tzSel = document.getElementById('edit-tz-select');
            const known = Array.from(tzSel.options).some(o => o.value === tz);
            tzSel.value = known && tz ? tz : '__custom__';
            document.getElementById('edit-timezone').value = tz;
            document.getElementById('tz-custom-wrap').style.display = (known && tz) ? 'none' : 'block';

            const syncEnabled = currentTimeConfig.sync_hour !== 255;
            document.getElementById('edit-sync-enabled').checked = syncEnabled;
            document.getElementById('edit-sync-hour').value = syncEnabled ? currentTimeConfig.sync_hour : 3;
            document.getElementById('edit-sync-minute').value = syncEnabled ? currentTimeConfig.sync_minute : 0;

            toggleSyncTimeFields();
            showModal('edit-time-modal');
        }

        // Timezone dropdown -> keep the hidden POSIX field (read on save) in sync.
        // "Custom" reveals the raw text box; a preset copies its POSIX string across.
        function onTzSelect() {
            const sel = document.getElementById('edit-tz-select');
            const wrap = document.getElementById('tz-custom-wrap');
            const tzInput = document.getElementById('edit-timezone');
            if (sel.value === '__custom__') {
                wrap.style.display = 'block';
                tzInput.focus();
            } else {
                wrap.style.display = 'none';
                tzInput.value = sel.value;
            }
        }

        function toggleSyncTimeFields() {
            const syncEnabled = document.getElementById('edit-sync-enabled').checked;
            const syncFields = document.getElementById('sync-time-fields');
            syncFields.style.display = syncEnabled ? 'block' : 'none';
        }

        async function saveTimeConfig() {
            const ntp1 = document.getElementById('edit-ntp1').value.trim();
            const ntp2 = document.getElementById('edit-ntp2').value.trim();
            const timezone = document.getElementById('edit-timezone').value.trim();
            const syncEnabled = document.getElementById('edit-sync-enabled').checked;
            const syncHour = syncEnabled ? parseInt(document.getElementById('edit-sync-hour').value) : 255;
            const syncMinute = syncEnabled ? parseInt(document.getElementById('edit-sync-minute').value) : 0;

            // Validation
            if (!ntp1) {
                showError('Primary NTP server is required');
                return;
            }

            if (!timezone) {
                showError('Timezone is required');
                return;
            }

            if (syncEnabled) {
                if (isNaN(syncHour) || syncHour < 0 || syncHour > 23) {
                    showError('Sync hour must be between 0 and 23');
                    return;
                }
                if (isNaN(syncMinute) || syncMinute < 0 || syncMinute > 59) {
                    showError('Sync minute must be between 0 and 59');
                    return;
                }
            }

            try {
                const response = await authFetch('/api/config/time', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        ntp_server1: ntp1,
                        ntp_server2: ntp2,
                        timezone: timezone,
                        sync_hour: syncHour,
                        sync_minute: syncMinute
                    })
                });

                const data = await response.json();

                if (data.ok) {
                    closeModal('edit-time-modal');
                    alert('Time configuration saved. Changes will apply after reboot.');
                    loadSettings(); // Reload to show new values
                } else {
                    showError(data.error || 'Failed to save time configuration');
                }
            } catch (error) {
                showError('Network error: ' + error.message);
            }
        }

        // MQTT configuration
        let currentMqttConfig = null;

        function displayMqttConfig(config) {
            currentMqttConfig = config; // Store for editing
            document.getElementById('mqtt-enabled').textContent = config.enabled ? 'Yes' : 'No';
            document.getElementById('mqtt-broker-uri').textContent = config.broker_uri;
            document.getElementById('mqtt-username').textContent = config.username || '(none)';
            document.getElementById('mqtt-password').textContent = config.password_set ? 'â€¢â€¢â€¢â€¢â€¢â€¢â€¢â€¢' : '(none)';
            document.getElementById('mqtt-client-id').textContent = config.client_id;
            document.getElementById('mqtt-base-topic').textContent = config.base_topic;
            document.getElementById('mqtt-ha-discovery').textContent = config.homeassistant_discovery ? 'Enabled' : 'Disabled';
            document.getElementById('mqtt-qos').textContent = config.qos;
            document.getElementById('mqtt-retain').textContent = config.retain ? 'Yes' : 'No';
        }

        function showEditMqttModal() {
            if (!currentMqttConfig) {
                showError('MQTT configuration not loaded');
                return;
            }

            // Populate form with current values
            document.getElementById('edit-mqtt-enabled').checked = currentMqttConfig.enabled;
            document.getElementById('edit-mqtt-broker-uri').value = currentMqttConfig.broker_uri || '';
            document.getElementById('edit-mqtt-username').value = currentMqttConfig.username || '';
            // Password is never sent to the client; leave blank to keep the stored one.
            document.getElementById('edit-mqtt-password').value = '';
            document.getElementById('edit-mqtt-password').placeholder = currentMqttConfig.password_set ? '(unchanged)' : '(none set)';
            document.getElementById('edit-mqtt-client-id').value = currentMqttConfig.client_id || '';
            document.getElementById('edit-mqtt-base-topic').value = currentMqttConfig.base_topic || '';
            document.getElementById('edit-mqtt-ha-discovery').checked = currentMqttConfig.homeassistant_discovery;
            document.getElementById('edit-mqtt-qos').value = currentMqttConfig.qos.toString();
            document.getElementById('edit-mqtt-retain').checked = currentMqttConfig.retain;

            showModal('edit-mqtt-modal');
        }

        async function saveMqttConfig() {
            const enabled = document.getElementById('edit-mqtt-enabled').checked;
            const brokerUri = document.getElementById('edit-mqtt-broker-uri').value.trim();
            const username = document.getElementById('edit-mqtt-username').value.trim();
            const password = document.getElementById('edit-mqtt-password').value.trim();
            const clientId = document.getElementById('edit-mqtt-client-id').value.trim();
            const baseTopic = document.getElementById('edit-mqtt-base-topic').value.trim();
            const haDiscovery = document.getElementById('edit-mqtt-ha-discovery').checked;
            const qos = parseInt(document.getElementById('edit-mqtt-qos').value);
            const retain = document.getElementById('edit-mqtt-retain').checked;

            // Validation
            if (enabled && !brokerUri) {
                showError('Broker URI is required when MQTT is enabled');
                return;
            }

            if (enabled && !clientId) {
                showError('Client ID is required');
                return;
            }

            if (enabled && !baseTopic) {
                showError('Base topic is required');
                return;
            }

            try {
                const response = await authFetch('/api/config/mqtt', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        enabled: enabled,
                        broker_uri: brokerUri,
                        username: username,
                        password: password,
                        client_id: clientId,
                        base_topic: baseTopic,
                        homeassistant_discovery: haDiscovery,
                        qos: qos,
                        retain: retain
                    })
                });

                const data = await response.json();

                if (data.ok) {
                    closeModal('edit-mqtt-modal');
                    alert('MQTT configuration saved. Restart MQTT client or reboot to apply.');
                    loadSettings(); // Reload to show new values
                } else {
                    showError(data.error || 'Failed to save MQTT configuration');
                }
            } catch (error) {
                showError('Network error: ' + error.message);
            }
        }

        // Panel transport configuration
        let currentPanelConfig = null;

        function displayPanelConfig(config) {
            currentPanelConfig = config; // Store for editing
            const isUart = config.mode === 'uart';
            const isUdp = config.mode === 'udp';
            document.getElementById('panel-mode').textContent =
                isUart ? 'Onboard UART' : isUdp ? 'UDP (network)' : 'USB Host (CDC-ACM)';
            // UART-specific values only meaningful in UART mode
            document.getElementById('panel-tx-gpio').textContent =
                isUart ? ('GPIO' + config.tx_gpio) : '-';
            document.getElementById('panel-rx-gpio').textContent =
                isUart ? ('GPIO' + config.rx_gpio) : '-';
            document.getElementById('panel-baud').textContent =
                isUart ? config.baud : '-';
            document.getElementById('panel-udp').textContent =
                isUdp ? ((config.udp_ip || '?') + ' (remote ' + (config.udp_remote_port || '?')
                        + ', local ' + (config.udp_local_port || 0) + ')') : '-';
        }

        function togglePanelUartFields() {
            const mode = document.getElementById('edit-panel-mode').value;
            document.getElementById('panel-uart-fields').style.display = mode === 'uart' ? 'block' : 'none';
            document.getElementById('panel-udp-fields').style.display = mode === 'udp' ? 'block' : 'none';
        }

        function showEditPanelModal() {
            if (!currentPanelConfig) {
                showError('Panel configuration not loaded');
                return;
            }
            document.getElementById('edit-panel-mode').value = currentPanelConfig.mode || 'usb';
            document.getElementById('edit-panel-tx-gpio').value = currentPanelConfig.tx_gpio;
            document.getElementById('edit-panel-rx-gpio').value = currentPanelConfig.rx_gpio;
            document.getElementById('edit-panel-baud').value = currentPanelConfig.baud;
            document.getElementById('edit-panel-udp-ip').value = currentPanelConfig.udp_ip || '';
            document.getElementById('edit-panel-udp-remote-port').value = currentPanelConfig.udp_remote_port || '';
            document.getElementById('edit-panel-udp-local-port').value =
                (currentPanelConfig.udp_local_port !== undefined ? currentPanelConfig.udp_local_port : '');
            togglePanelUartFields();
            showModal('edit-panel-modal');
        }

        async function savePanelConfig() {
            const mode = document.getElementById('edit-panel-mode').value;
            const txGpio = parseInt(document.getElementById('edit-panel-tx-gpio').value);
            const rxGpio = parseInt(document.getElementById('edit-panel-rx-gpio').value);
            const baud = parseInt(document.getElementById('edit-panel-baud').value);
            const udpIp = document.getElementById('edit-panel-udp-ip').value.trim();
            const udpRemotePort = parseInt(document.getElementById('edit-panel-udp-remote-port').value);
            const udpLocalPort = parseInt(document.getElementById('edit-panel-udp-local-port').value);

            if (mode === 'uart') {
                if (isNaN(txGpio) || isNaN(rxGpio) || txGpio === rxGpio) {
                    showError('UART mode needs distinct TX and RX GPIO pins');
                    return;
                }
                if (isNaN(baud) || baud < 1200 || baud > 115200) {
                    showError('Baud rate must be between 1200 and 115200');
                    return;
                }
            }

            if (mode === 'udp') {
                if (!/^(\d{1,3}\.){3}\d{1,3}$/.test(udpIp)) {
                    showError('Enter a valid panel IPv4 address (e.g. 192.168.0.50)');
                    return;
                }
                if (isNaN(udpRemotePort) || udpRemotePort < 1 || udpRemotePort > 65535) {
                    showError('Remote (panel) port must be between 1 and 65535');
                    return;
                }
                if (isNaN(udpLocalPort) || udpLocalPort < 0 || udpLocalPort > 65535) {
                    showError('Local port must be between 0 and 65535 (0 = ephemeral)');
                    return;
                }
            }

            if (!confirm('This will save the panel transport and reboot the device. Continue?')) {
                return;
            }

            try {
                const response = await authFetch('/api/config/panel', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        mode: mode,
                        tx_gpio: isNaN(txGpio) ? 0 : txGpio,
                        rx_gpio: isNaN(rxGpio) ? 0 : rxGpio,
                        baud: isNaN(baud) ? 9600 : baud,
                        udp_ip: udpIp,
                        udp_remote_port: isNaN(udpRemotePort) ? 0 : udpRemotePort,
                        udp_local_port: isNaN(udpLocalPort) ? 0 : udpLocalPort
                    })
                });

                const data = await response.json();

                if (data.ok) {
                    closeModal('edit-panel-modal');
                    alert('Panel transport saved. The device is rebooting to apply the change.');
                } else {
                    showError(data.error || 'Failed to save panel configuration');
                }
            } catch (error) {
                showError('Network error: ' + error.message);
            }
        }

        async function logout() {
            await authFetch('/api/logout', { method: 'POST' }).catch(() => {});
            localStorage.clear();
            window.location.href = '/ui/login';
        }

        // Periodic session check - pings server to detect session expiry
        async function checkSession() {
            try {
                // Use session check endpoint (readonly - won't reset timeout)
                await authFetch('/api/session/check');
            } catch (error) {
                // authFetch will handle 401 and redirect to login
                console.error('Session check failed:', error);
            }
        }

        // Load on page ready
        window.addEventListener('load', () => {
            loadSettings();
            // Check session every 10 seconds to detect expiry
            setInterval(checkSession, 10000);
        });
    </script>
</div>
</div>
<script src="/ui/theme.js"></script>
</body>
</html>
␀
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orisec Gateway - Login</title>
    <link rel="stylesheet" href="/ui/theme.css">
</head>
<body>
    <div class="login-container">
        <h1>Orisec Gateway</h1>
        <p class="subtitle">Security Panel Management</p>

        <div id="error-message" class="error"></div>
        <div id="warning-message" class="warning" style="display:none"></div>

        <!-- Login Form -->
        <form id="login-form">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required autofocus>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>
            </div>

            <button type="submit" id="login-btn">Login</button>
        </form>

        <!-- Change Password Form (shown if must_change_password) -->
        <form id="change-password-form">
            <div class="warning">
                <strong>Password Change Required</strong><br>
                You must change your password before continuing.
            </div>

            <div class="form-group">
                <label for="current-password">Current Password</label>
                <input type="password" id="current-password" required>
            </div>

            <div class="form-group">
                <label for="new-password">New Password</label>
                <input type="password" id="new-password" required>
                <div class="password-requirements">
                    Password must contain:
                    <ul>
                        <li>At least 8 characters</li>
                        <li>Uppercase and lowercase letters</li>
                        <li>At least one digit</li>
                        <li>At least one special character</li>
                    </ul>
                </div>
            </div>

            <div class="form-group">
                <label for="confirm-password">Confirm New Password</label>
                <input type="password" id="confirm-password" required>
            </div>

            <button type="submit" id="change-password-btn">Change Password</button>
        </form>

        <div class="loading" id="loading">Processing...</div>
    </div>

    <script>
        let sessionToken = null;
        let currentUsername = null;

        const loginForm = document.getElementById('login-form');
        const changePasswordForm = document.getElementById('change-password-form');
        const errorMessage = document.getElementById('error-message');
        const warningMessage = document.getElementById('warning-message');
        const loading = document.getElementById('loading');

        // Login handler
        loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            hideError();

            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;

            showLoading();

            try {
                const response = await fetch('/api/login', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({username, password})
                });

                const data = await response.json();
                hideLoading();

                if (!data.ok) {
                    showError(data.error || 'Login failed');
                    return;
                }

                sessionToken = data.token;
                currentUsername = data.username;

                // Store token
                localStorage.setItem('auth_token', sessionToken);
                localStorage.setItem('auth_username', currentUsername);
                localStorage.setItem('auth_role', data.role);

                if (data.must_change_password) {
                    // Show password change form
                    document.getElementById('current-password').value = password;
                    showPasswordChangeForm();
                } else {
                    // Redirect to main page
                    window.location.href = '/ui/zones';
                }

            } catch (error) {
                hideLoading();
                showError('Network error: ' + error.message);
            }
        });

        // Change password handler
        changePasswordForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            hideError();

            const currentPassword = document.getElementById('current-password').value;
            const newPassword = document.getElementById('new-password').value;
            const confirmPassword = document.getElementById('confirm-password').value;

            if (newPassword !== confirmPassword) {
                showError('New passwords do not match');
                return;
            }

            showLoading();

            try {
                const response = await fetch('/api/change-password', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + sessionToken
                    },
                    body: JSON.stringify({
                        current_password: currentPassword,
                        new_password: newPassword
                    })
                });

                const data = await response.json();
                hideLoading();

                if (!data.ok) {
                    showError(data.error || 'Password change failed');
                    return;
                }

                // Password changed - clear session and redirect to login
                alert('Password changed successfully! Please login again.');
                localStorage.clear();
                window.location.href = '/ui/login';

            } catch (error) {
                hideLoading();
                showError('Network error: ' + error.message);
            }
        });

        function showPasswordChangeForm() {
            loginForm.classList.add('hide');
            changePasswordForm.classList.add('show');
        }

        function showError(msg) {
            errorMessage.textContent = msg;
            errorMessage.classList.add('show');
        }

        function hideError() {
            errorMessage.classList.remove('show');
        }

        function showLoading() {
            loading.classList.add('show');
        }

        function hideLoading() {
            loading.classList.remove('show');
        }

        // Check if already logged in
        window.addEventListener('load', () => {
            const token = localStorage.getItem('auth_token');
            if (token) {
                // Validate token
                fetch('/api/session/validate', {
                    headers: {'Authorization': 'Bearer ' + token}
                })
                .then(r => r.json())
                .then(data => {
                    if (data.ok) {
                        // Already logged in - redirect
                        window.location.href = '/ui/zones';
                    }
                });
            }
        });
    </script>
<script src="/ui/theme.js"></script>
</body>
</html>
␀<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orisec Gateway - Partitions</title>
<link rel="stylesheet" href="/ui/theme.css">
</head>
<body>
<div class="app-shell">
<aside class="sidebar">
<div class="app-brand"><div class="brand-mark">O</div><div><div class="brand-name">ORISEC</div><div class="brand-sub">Gateway</div></div></div>
<nav class="sidebar-nav">
<a href="/ui/zones"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1.3"/><rect x="14" y="3" width="7" height="7" rx="1.3"/><rect x="3" y="14" width="7" height="7" rx="1.3"/><rect x="14" y="14" width="7" height="7" rx="1.3"/></svg><span>Zones</span></a>
<a href="/ui/areas" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="5" rx="1.3"/><rect x="3" y="15" width="18" height="5" rx="1.3"/></svg><span>Partitions</span></a>
<a href="/ui/keypad"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="6" cy="6" r="1.9"/><circle cx="12" cy="6" r="1.9"/><circle cx="18" cy="6" r="1.9"/><circle cx="6" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="18" cy="12" r="1.9"/><circle cx="6" cy="18" r="1.9"/><circle cx="12" cy="18" r="1.9"/><circle cx="18" cy="18" r="1.9"/></svg><span>Keypad</span></a>
<a href="/ui/outputs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3v9"/><path d="M6.5 7a8 8 0 1 0 11 0"/></svg><span>Outputs</span></a>
<a href="/ui/system-flags"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 5 15L17 12h4"/></svg><span>System</span></a>
<a href="/ui/settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><line x1="4" y1="8" x2="20" y2="8"/><circle cx="9" cy="8" r="2.4" fill="currentColor" stroke="none"/><line x1="4" y1="16" x2="20" y2="16"/><circle cx="15" cy="16" r="2.4" fill="currentColor" stroke="none"/></svg><span>Settings</span></a>
</nav>
<a href="#" class="sidebar-logout" onclick="if(typeof logout===&quot;function&quot;){logout();}else{location.href=&quot;/ui/login&quot;;}return false;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3"/><path d="M10 8l-4 4 4 4"/><path d="M6 12h9"/></svg><span>Logout</span></a>
</aside>
<div class="sidebar-scrim"></div>
<div class="app-main">
<div class="header">
<h1>ORISEC GATEWAY - PARTITIONS</h1>
<div class="nav">
<a href="/ui/zones">Zones</a> | <a href="/ui/areas">Partitions</a> | <a href="/ui/keypad">Keypad</a> | <a href="/ui/outputs">Outputs</a> | <a href="/ui/system-flags">System Flags</a> | <a href="/ui/settings">Settings</a> | <a href="#" onclick="logout(); return false;" style="color:#ff6b6b;">Logout</a>
</div>
<div class="status-bar">
<span class="status-badge badge-disconnected" id="conn-badge">DISCONNECTED</span>
<span class="status-badge badge-info" id="time-badge">Last Update: --</span>
<span class="status-badge badge-info" id="ac-badge">AC: --</span>
<span class="status-badge badge-info" id="batt-badge">BATT: --</span>
</div>
</div>
<div class="container">
<div class="partitions-grid" id="partitions-grid"></div>
<div class="detail-panel" id="detail-panel">
<div class="detail-header">
<div class="detail-title" id="detail-title"></div>
<div class="detail-state-label" id="detail-state"></div>
</div>
<div class="section-title">STATE</div>
<div class="state-loading" id="state-text">Loading...</div>
<div class="section-title">FLAGS</div>
<div class="flags-row" id="flags-row"></div>
<div class="section-title">CONTROLS</div>
<div class="controls-row" id="controls-row"></div>
</div>
</div>
<script>
const token = localStorage.getItem('auth_token');
if (!token) window.location.href = '/ui/login';

async function authFetch(url, options = {}) {
  options.headers = options.headers || {};
  options.headers['Authorization'] = 'Bearer ' + token;
  const r = await fetch(url, options);
  if (r.status === 401) { localStorage.clear(); window.location.href = '/ui/login'; throw new Error('Session expired'); }
  return r;
}

let selectedId = null;
let partitionCount = 8;
let partitionsData = [];

async function init() {
  try {
    const r = await authFetch('/info');
    const d = await r.json();
    if (d.panel) partitionCount = d.panel.partitions || 8;
  } catch(e) { console.error('Failed to load panel info', e); }
  await refresh();
  setInterval(refresh, 2000);
  setInterval(refreshStatus, 15000);
  refreshStatus();
}

async function refreshStatus() {
  try {
    const r = await authFetch('/healthz');
    const d = await r.json();
    const cb = document.getElementById('conn-badge');
    if (d.panel_online) { cb.textContent = 'CONNECTED'; cb.className = 'status-badge badge-connected'; }
    else { cb.textContent = 'DISCONNECTED'; cb.className = 'status-badge badge-disconnected'; }
  } catch(e) {}
  try {
    const r = await authFetch('/api/system/power');
    const d = await r.json();
    if (d.ok) {
      const ac = document.getElementById('ac-badge');
      const bt = document.getElementById('batt-badge');
      if (d.psu_ac_fail) { ac.textContent = 'AC: FAIL'; ac.className = 'status-badge badge-ac-fail'; }
      else { ac.textContent = 'AC: OK'; ac.className = 'status-badge badge-ac-ok'; }
      if (d.psu_battery_fail) { bt.textContent = 'BATT: FAIL'; bt.className = 'status-badge badge-batt-fail'; }
      else { bt.textContent = 'BATT: OK'; bt.className = 'status-badge badge-batt-ok'; }
    }
  } catch(e) {}
}

// Panel status character to descriptive text
const PSTATE_MAP = {
  'D': { text: 'Disarmed', cls: 'disarmed' },
  'F': { text: 'Fully Armed', cls: 'armed' },
  '1': { text: 'Stay Armed 1', cls: 'part_armed' },
  '2': { text: 'Stay Armed 2', cls: 'part_armed' },
  '3': { text: 'Stay Armed 3', cls: 'part_armed' },
  'X': { text: 'Not Assigned', cls: '' },
  'A': { text: 'ALARM', cls: 'alarm' },
  'C': { text: 'Exit Timer', cls: 'exit' },
  'a': { text: 'Disarmed - Not Ready (Reset Required)', cls: 'disarmed' }
};

function stateLabel(flags, getp) {
  // Use the raw status character if available
  if (getp && PSTATE_MAP[getp]) return PSTATE_MAP[getp];
  // Fallback to flag-based detection
  if (!flags) return { text: 'Unknown', cls: '' };
  if (flags.alarm) return { text: 'ALARM', cls: 'alarm' };
  if (flags.exit) return { text: 'Exit Timer', cls: 'exit' };
  if (flags.armed) return { text: 'Fully Armed', cls: 'armed' };
  if (flags.part_armed) return { text: 'Stay Armed', cls: 'part_armed' };
  return { text: 'Disarmed', cls: 'disarmed' };
}

async function refresh() {
  try {
    const r = await authFetch(`/areas?start=1&count=${partitionCount}`);
    const d = await r.json();
    partitionsData = d.items || [];
    document.getElementById('time-badge').textContent = 'Last Update: ' + new Date().toLocaleTimeString();
    renderGrid();
    if (selectedId) renderDetail();
  } catch(e) { console.error('Refresh failed', e); }
}

function renderGrid() {
  const grid = document.getElementById('partitions-grid');
  grid.innerHTML = '';
  partitionsData.forEach(p => {
    const sl = stateLabel(p.flags, p.getp);
    const card = document.createElement('div');
    card.className = `part-card ${sl.cls} ${selectedId === p.id ? 'selected' : ''}`;
    const numEl = document.createElement('div');
    numEl.className = 'part-num';
    numEl.textContent = 'P' + String(p.id).padStart(2,'0');
    const nameEl = document.createElement('div');
    nameEl.className = 'part-name';
    nameEl.textContent = p.name || ('Partition ' + p.id);
    const stateEl = document.createElement('div');
    stateEl.className = 'part-state';
    stateEl.textContent = sl.text;
    card.appendChild(numEl); card.appendChild(nameEl); card.appendChild(stateEl);
    card.onclick = () => { selectedId = p.id; renderGrid(); renderDetail(); };
    grid.appendChild(card);
  });
}

function renderDetail() {
  const panel = document.getElementById('detail-panel');
  const p = partitionsData.find(x => x.id === selectedId);
  if (!p) { panel.classList.remove('show'); return; }
  panel.classList.add('show');
  const sl = stateLabel(p.flags, p.getp);
  document.getElementById('detail-title').textContent = `Partition ${p.id}: ${p.name || 'Partition ' + p.id}`;
  const stEl = document.getElementById('detail-state');
  stEl.textContent = sl.text;
  stEl.className = `detail-state-label ${sl.cls}`;
  const getp = p.getp || '-';
  const pstateInfo = PSTATE_MAP[getp] || { text: 'Unknown (' + getp + ')' };
  document.getElementById('state-text').textContent = getp + ' = ' + pstateInfo.text;
  // Partition status flags from the panel
  const fr = document.getElementById('flags-row');
  const pf = p.pflags || {};
  const pflagsRawEl = document.getElementById('pflags-raw');
  if (pflagsRawEl) pflagsRawEl.textContent = p.pflags_raw !== undefined ? '(raw: 0x' + p.pflags_raw.toString(16).toUpperCase().padStart(2,'0') + ')' : '';
  const flagDefs = [
    { key: 'ready', label: 'Ready', icon: '\u2713', green: true },
    { key: 'exit_entry', label: 'Exit/Entry', icon: '\u23F1', green: false },
    { key: 'arm_failed', label: 'Arm Failed', icon: '\u2716', green: false },
    { key: 'engineer_needed', label: 'Engineer Needed', icon: '\uD83D\uDD27', green: false },
    { key: 'alarm', label: 'Alarm', icon: '\u26A0', green: false },
    { key: 'confirmed_alarm', label: 'Confirmed Alarm', icon: '\u26A0\u26A0', green: false },
    { key: 'pa', label: 'PA', icon: '\uD83D\uDEA8', green: false },
    { key: 'fire', label: 'Fire', icon: '\uD83D\uDD25', green: false }
  ];
  fr.innerHTML = '';
  flagDefs.forEach(f => {
    const active = pf[f.key];
    const box = document.createElement('div');
    box.className = `flag-box ${active ? 'active' : ''} ${active && f.green ? 'green' : ''}`;
    box.innerHTML = `<div class="flag-label">${f.label}</div><div class="flag-icon">${f.icon}</div>`;
    fr.appendChild(box);
  });
  // Controls
  const cr = document.getElementById('controls-row');
  cr.innerHTML = '';
  const btns = [
    { label: 'ARM', cls: 'btn-arm', action: `/areas/arm?id=${p.id}` },
    { label: 'STAY ARM', cls: 'btn-stay', action: `/areas/part-arm?id=${p.id}` },
    { label: 'DISARM', cls: 'btn-disarm', action: `/areas/disarm?id=${p.id}` },
    { label: 'RESET ALARM', cls: 'btn-reset', action: `/areas/reset?id=${p.id}` }
  ];
  btns.forEach(b => {
    const el = document.createElement('button');
    el.className = `btn ${b.cls}`;
    el.textContent = b.label;
    el.onclick = async () => {
      try {
        const r = await authFetch(b.action, { method: 'POST' });
        const d = await r.json();
        if (!d.ok) alert(d.error || 'Command failed');
        setTimeout(refresh, 500);
      } catch(e) { alert('Failed: ' + e.message); }
    };
    cr.appendChild(el);
  });
  // (debug builds only)
  const rawJsonEl = document.getElementById('raw-json-content');
  if (rawJsonEl) rawJsonEl.textContent = JSON.stringify(p, null, 2);
}

async function logout() {
  await authFetch('/api/logout', { method: 'POST' }).catch(() => {});
  localStorage.clear();
  window.location.href = '/ui/login';
}

init();
</script>
</div>
</div>
<script src="/ui/theme.js"></script>
</body>
</html>
␀<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
