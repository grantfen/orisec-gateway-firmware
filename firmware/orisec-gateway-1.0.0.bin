<title>Orisec Gateway - Keypad</title>
<link rel="stylesheet" href="/ui/theme.css">
</head>
<body>
<div class="app-shell">
<aside class="sidebar">
<div class="app-brand"><div class="brand-mark">O</div><div><div class="brand-name">ORISEC</div><div class="brand-sub">Gateway</div></div></div>
<nav class="sidebar-nav">
<a href="/ui/zones"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1.3"/><rect x="14" y="3" width="7" height="7" rx="1.3"/><rect x="3" y="14" width="7" height="7" rx="1.3"/><rect x="14" y="14" width="7" height="7" rx="1.3"/></svg><span>Zones</span></a>
<a href="/ui/areas"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="5" rx="1.3"/><rect x="3" y="15" width="18" height="5" rx="1.3"/></svg><span>Partitions</span></a>
<a href="/ui/keypad" class="active"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="6" cy="6" r="1.9"/><circle cx="12" cy="6" r="1.9"/><circle cx="18" cy="6" r="1.9"/><circle cx="6" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="18" cy="12" r="1.9"/><circle cx="6" cy="18" r="1.9"/><circle cx="12" cy="18" r="1.9"/><circle cx="18" cy="18" r="1.9"/></svg><span>Keypad</span></a>
<a href="/ui/outputs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3v9"/><path d="M6.5 7a8 8 0 1 0 11 0"/></svg><span>Outputs</span></a>
<a href="/ui/system-flags"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 5 15L17 12h4"/></svg><span>System</span></a>
<a href="/ui/settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><line x1="4" y1="8" x2="20" y2="8"/><circle cx="9" cy="8" r="2.4" fill="currentColor" stroke="none"/><line x1="4" y1="16" x2="20" y2="16"/><circle cx="15" cy="16" r="2.4" fill="currentColor" stroke="none"/></svg><span>Settings</span></a>
</nav>
<a href="#" class="sidebar-logout" onclick="if(typeof logout===&quot;function&quot;){logout();}else{location.href=&quot;/ui/login&quot;;}return false;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3"/><path d="M10 8l-4 4 4 4"/><path d="M6 12h9"/></svg><span>Logout</span></a>
</aside>
<div class="sidebar-scrim"></div>
<div class="app-main">
<div class="header">
<h1>ORISEC GATEWAY - KEYPAD</h1>
<div class="nav">
<a href="/ui/zones">Zones</a> | <a href="/ui/areas">Partitions</a> | <a href="/ui/keypad">Keypad</a> | <a href="/ui/outputs">Outputs</a> | <a href="/ui/system-flags">System Flags</a> | <a href="/ui/settings">Settings</a> | <a href="#" onclick="logout(); return false;" style="color:#ff6b6b;">Logout</a>
</div>
<div class="status-bar">
<span class="status-badge badge-disconnected" id="conn-badge">DISCONNECTED</span>
<span class="status-badge badge-info" id="time-badge">Last Update: --</span>
<span class="status-badge badge-info" id="ac-badge">AC: --</span>
<span class="status-badge badge-info" id="batt-badge">BATT: --</span>
</div>
</div>
<div class="container">
<div class="keypad-panel">
<div class="lcd">
<canvas id="lcd-canvas" width="512" height="128"></canvas>
</div>
<div class="keypad-body">
<button class="key num" style="grid-area:n1" onclick="pressKey('1')">1</button>
<button class="key num" style="grid-area:n2" onclick="pressKey('2')">2<small>abc</small></button>
<button class="key num" style="grid-area:n3" onclick="pressKey('3')">3<small>def</small></button>
<button class="key fn" style="grid-area:fa" onclick="pressKey('ARM')">Arm</button>
<button class="key nav" style="grid-area:up" onclick="pressKey('UP')">&#9650;</button>
<button class="key num" style="grid-area:n4" onclick="pressKey('4')">4<small>ghi</small></button>
<button class="key num" style="grid-area:n5" onclick="pressKey('5')">5<small>jkl</small></button>
<button class="key num" style="grid-area:n6" onclick="pressKey('6')">6<small>mno</small></button>
<button class="key fn" style="grid-area:fb" onclick="pressKey('PART')">Part</button>
<button class="key nav" style="grid-area:lt" onclick="pressKey('LEFT')">&#9664;</button>
<button class="key nav" style="grid-area:rt" onclick="pressKey('RIGHT')">&#9654;</button>
<button class="key num" style="grid-area:n7" onclick="pressKey('7')">7<small>pqrs</small></button>
<button class="key num" style="grid-area:n8" onclick="pressKey('8')">8<small>tuv</small></button>
<button class="key num" style="grid-area:n9" onclick="pressKey('9')">9<small>wxyz</small></button>
<button class="key fn" style="grid-area:fc" onclick="pressKey('AREA')">Area</button>
<button class="key nav" style="grid-area:dn" onclick="pressKey('DOWN')">&#9660;</button>
<button class="key enter" style="grid-area:ne" onclick="pressKey('ENTER')">Enter<small>&#10003;</small></button>
<button class="key num" style="grid-area:n0" onclick="pressKey('0')">0</button>
<button class="key clear" style="grid-area:nc" onclick="pressKey('CLEAR')">Clear<small>&#10007;</small></button>
<button class="key fn" style="grid-area:fd" onclick="pressKey('OMIT')">Omit</button>
<button class="key fn" style="grid-area:ch" onclick="pressKey('CHIME')">Chime<small>&#9834;</small></button>
<button class="key fn" style="grid-area:bk" onclick="pressKey('BACK')">Back<small>&#8592;</small></button>
</div>
