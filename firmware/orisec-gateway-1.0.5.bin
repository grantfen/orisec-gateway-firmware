<script>
const token = localStorage.getItem('auth_token');
if (!token) window.location.href = '/ui/login';

async function authFetch(url, options = {}) {
  options.headers = options.headers || {};
  options.headers['Authorization'] = 'Bearer ' + token;
  const r = await fetch(url, options);
  if (r.status === 401) { localStorage.clear(); window.location.href = '/ui/login'; throw new Error('Session expired'); }
  return r;
}

async function pressKey(key) {
  try {
    const r = await authFetch('/keypad/press', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key: key })
    });
    const d = await r.json();
    if (d.ok) setTimeout(updateLCD, 250);
  } catch (e) { console.error('Keypress error:', e); }
}

