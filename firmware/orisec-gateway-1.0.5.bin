<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orisec Gateway - Live Status</title>
<link rel="stylesheet" href="/ui/theme.css">
</head>
<body>
<div class="app-shell">
<aside class="sidebar">
<div class="app-brand"><div class="brand-mark">O</div><div><div class="brand-name">ORISEC</div><div class="brand-sub">Gateway</div></div></div>
<nav class="sidebar-nav">
<a href="/ui/zones" class="active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1.3"/><rect x="14" y="3" width="7" height="7" rx="1.3"/><rect x="3" y="14" width="7" height="7" rx="1.3"/><rect x="14" y="14" width="7" height="7" rx="1.3"/></svg><span>Zones</span></a>
<a href="/ui/areas"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="5" rx="1.3"/><rect x="3" y="15" width="18" height="5" rx="1.3"/></svg><span>Partitions</span></a>
<a href="/ui/keypad"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="6" cy="6" r="1.9"/><circle cx="12" cy="6" r="1.9"/><circle cx="18" cy="6" r="1.9"/><circle cx="6" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="18" cy="12" r="1.9"/><circle cx="6" cy="18" r="1.9"/><circle cx="12" cy="18" r="1.9"/><circle cx="18" cy="18" r="1.9"/></svg><span>Keypad</span></a>
<a href="/ui/outputs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 3v9"/><path d="M6.5 7a8 8 0 1 0 11 0"/></svg><span>Outputs</span></a>
<a href="/ui/system-flags"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 5 15L17 12h4"/></svg><span>System</span></a>
<a href="/ui/settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><line x1="4" y1="8" x2="20" y2="8"/><circle cx="9" cy="8" r="2.4" fill="currentColor" stroke="none"/><line x1="4" y1="16" x2="20" y2="16"/><circle cx="15" cy="16" r="2.4" fill="currentColor" stroke="none"/></svg><span>Settings</span></a>
</nav>
<a href="#" class="sidebar-logout" onclick="if(typeof logout===&quot;function&quot;){logout();}else{location.href=&quot;/ui/login&quot;;}return false;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h3a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-3"/><path d="M10 8l-4 4 4 4"/><path d="M6 12h9"/></svg><span>Logout</span></a>
</aside>
<div class="sidebar-scrim"></div>
<div class="app-main">
<div class="header">
<h1>ORISEC GATEWAY - LIVE STATUS</h1>
<div class="nav" style="text-align:center; margin:10px 0;"><a href="/ui/zones" style="color:#37b9e4; text-decoration:none; font-size:14px;">Zones</a> | <a href="/ui/areas" style="color:#37b9e4; text-decoration:none; font-size:14px;">Partitions</a> | <a href="/ui/keypad" style="color:#37b9e4; text-decoration:none; font-size:14px;">Keypad</a> | <a href="/ui/outputs" style="color:#37b9e4; text-decoration:none; font-size:14px;">Outputs</a> | <a href="/ui/system-flags" style="color:#37b9e4; text-decoration:none; font-size:14px;">System Flags</a> | <a href="/ui/settings" style="color:#37b9e4; text-decoration:none; font-size:14px;">Settings</a> | <a href="#" onclick="logout(); return false;" style="color:#ff6b6b; text-decoration:none; font-size:14px;">Logout</a></div>
<div class="status-bar">
<span class="status-badge badge-disconnected" id="connection-status">CONNECTING...</span>
<span class="status-badge badge-info" id="last-update">Last Update: --</span>
<span class="status-badge badge-ac-ok" id="power-status" title="Mains Power">AC: OK</span>
<span class="status-badge badge-batt-ok" id="battery-status" title="Battery">BATT: OK</span>
<span class="status-badge badge-info" id="tamper-status" title="Tampers" style="display:none;">TAMPER</span>
</div>
</div>
<div class="section-title">PARTITIONS</div>
<div class="area-container" id="area-container"></div>
<div class="section-title">ZONES</div>
<div class="grid-container" id="zone-grid"></div>
<div class="legend">
<strong>Legend:</strong>
<div class="legend-items">
<div class="legend-item"><div class="legend-color" style="background:#1b5e20"></div> Normal</div>
<div class="legend-item"><div class="legend-color" style="background:#f57f17"></div> Active (A)</div>
<div class="legend-item"><div class="legend-color" style="background:#e65100"></div> Tamper (T)</div>
<div class="legend-item"><div class="legend-color" style="background:#bf360c"></div> Fault (F)</div>
<div class="legend-item"><div class="legend-color" style="background:#b71c1c"></div> Alarm (L)</div>
<div class="legend-item"><div class="legend-color" style="background:#424242"></div> Bypassed (B)</div>
<div class="legend-item"><div class="legend-color" style="background:#263238"></div> Masked (M)</div>
<div class="legend-item"><div class="legend-color" style="background:#6a1b9a"></div> Multiple</div>
</div>
<div class="legend-items" style="margin-top:10px">
<strong>Partitions:</strong>
<div class="legend-item"><div class="legend-color" style="background:#1a4d5a"></div> Ready (R)</div>
<div class="legend-item"><div class="legend-color" style="background:#4d4d1a"></div> Unset Not Ready (-)</div>
<div class="legend-item"><div class="legend-color" style="background:#f57c00"></div> Exit - Flash Amber (X)</div>
<div class="legend-item"><div class="legend-color" style="background:#fdd835"></div> Entry - Flash Yellow (N)</div>
<div class="legend-item"><div class="legend-color" style="background:#8e24aa"></div> Part Armed (P)</div>
<div class="legend-item"><div class="legend-color" style="background:#5a1a1a"></div> Armed (A)</div>
<div class="legend-item"><div class="legend-color" style="background:#4a1a1a"></div> Alarm - Flashing Red (L)</div>
<div class="legend-item"><div class="legend-color" style="background:#1a1f2e"></div> Secured/Normal (S/-)</div>
</div>
</div>
<script>
// SEQUENTIAL LOADING FIX: Prevents TLS handshake collisions by loading resources one at a time
// Step 1: /info â†’ Step 2: /zones â†’ Step 3: /areas â†’ Step 4: WebSocket (with 1s delay)
const token = localStorage.getItem('auth_token');
if (!token) {
window.location.href = '/ui/login';
}
console.log('Auth OK - page loaded with JavaScript enabled');

// Helper to add auth header to fetch calls and handle session expiry
async function authFetch(url, options = {}) {
options.headers = options.headers || {};
options.headers['Authorization'] = 'Bearer ' + token;
const response = await fetch(url, options);
console.log('[authFetch]', url, 'status:', response.status);
if (response.status === 401) {
console.warn('[authFetch] Session expired! Logging out and redirecting to login');
localStorage.clear();
window.location.href = '/ui/login';
throw new Error('Session expired');
}
return response;
}
console.log('UI Script loaded');

const areaContainer = document.getElementById('area-container');
const zoneGrid = document.getElementById('zone-grid');
const connectionStatus = document.getElementById('connection-status');
const lastUpdateEl = document.getElementById('last-update');
const areas = {};
const zones = {};
let panelMaxZones = 640;  // Default, will be updated from /info
let panelMaxAreas = 64;   // Default, will be updated from /info

// Function to create area elements dynamically based on panel size
function createAreaElements(count) {
console.log(`Creating ${count} area elements`);
areaContainer.innerHTML = '';  // Clear existing
for (let i = 1; i <= count; i++) {
const areaEl = document.createElement('div');
areaEl.className = 'area normal';
areaEl.id = `area-${i}`;
areaEl.innerHTML = `<div class="area-header">A${String(i).padStart(2, '0')}-</div><div class="area-controls"><button class="btn-arm" onclick="armArea(${i}, false)" title="Full Arm">A</button><button class="btn-part" onclick="armArea(${i}, true)" title="Part Arm">P</button><button class="btn-disarm" onclick="disarmArea(${i})" title="Disarm">D</button></div>`;
areaEl.title = `Partition ${i} - Right-click for Reset option`;
areaEl.oncontextmenu = (e) => { e.preventDefault(); resetArea(i); return false; };
areaContainer.appendChild(areaEl);
areas[i] = areaEl;
}
}

// Function to create zone elements dynamically based on panel size
function createZoneElements(count) {
console.log(`Creating ${count} zone elements`);
zoneGrid.innerHTML = '';  // Clear existing
for (let i = 1; i <= count; i++) {
const zoneEl = document.createElement('div');
zoneEl.className = 'zone normal';
zoneEl.id = `zone-${i}`;
zoneEl.innerHTML = `<div class="zone-state">Z${String(i).padStart(3, '0')}-</div>`;
zoneEl.title = `Zone ${i} - Click to toggle omit`;
zoneEl.onclick = () => toggleOmitZone(i);
zoneGrid.appendChild(zoneEl);
zones[i] = zoneEl;
}
}

// Fetch panel info to determine actual zone/area counts
async function fetchPanelInfo() {
try {
const res = await authFetch('/info');
if (res.ok) {
const data = await res.json();
if (data.panel && data.panel.max_zones) {
panelMaxZones = data.panel.max_zones;
panelMaxAreas = data.panel.partitions || data.panel.max_areas || 64;
console.log(`Panel detected: ${data.panel.model || 'Unknown'} - ${panelMaxZones} zones, ${panelMaxAreas} partitions`);
}
}
} catch (e) {
console.warn('Failed to fetch panel info, using defaults (640 zones, 64 areas):', e);
}
// Create UI elements based on detected panel size
createAreaElements(panelMaxAreas);
createZoneElements(panelMaxZones);
}

// Startup: Fetch panel info and create UI elements, then fetch initial data SEQUENTIALLY
console.log('Starting client...');
// Mains/battery badges: poll the same /api/system/power source the other pages use,
// so AC/BATT status is consistent everywhere (these were previously static).
async function refreshPower() {
  try {
    const r = await authFetch('/api/system/power');
    const d = await r.json();
    if (!d.ok) return;
    const ps = document.getElementById('power-status');
    const bs = document.getElementById('battery-status');
    if (ps) { ps.textContent = d.psu_ac_fail ? 'AC: FAIL' : 'AC: OK'; ps.className = 'status-badge ' + (d.psu_ac_fail ? 'badge-ac-fail' : 'badge-ac-ok'); }
    if (bs) { bs.textContent = d.psu_battery_fail ? 'BATT: FAIL' : 'BATT: OK'; bs.className = 'status-badge ' + (d.psu_battery_fail ? 'badge-batt-fail' : 'badge-batt-ok'); }
  } catch(e) {}
}
// Connection badge reflects the PANEL status (via /healthz), consistent with the other
// pages: Connected, Invalid Code (wrong user code), or Disconnected (no comms).
async function refreshPanelStatus() {
  try {
    const r = await authFetch('/healthz');
    const h = await r.json();
    if (h.panel_online) { connectionStatus.textContent = 'CONNECTED'; connectionStatus.className = 'status-badge badge-connected'; }
    else if (h.reason === 'unauthorised') { connectionStatus.textContent = 'INVALID CODE'; connectionStatus.className = 'status-badge badge-disconnected'; }
    else { connectionStatus.textContent = 'DISCONNECTED'; connectionStatus.className = 'status-badge badge-disconnected'; }
  } catch(e) { connectionStatus.textContent = 'DISCONNECTED'; connectionStatus.className = 'status-badge badge-disconnected'; }
}
(async function init() {
await fetchPanelInfo();  // STEP 2: Fetch panel size and create UI elements
console.log('STEP 2 complete - panel info fetched, UI elements created');

// STEP 3: Fetch initial zone and area data SEQUENTIALLY (not in parallel)
console.log('STEP 3: Fetching zone data...');
const zRes = await authFetch(`/zones?start=1&count=${panelMaxZones}`);
const zData = await zRes.json();
if (zData.items) {
zData.items.forEach(updateZone);
console.log(`Loaded ${zData.items.length} zones`);
}

console.log('STEP 3: Fetching area data...');
const aRes = await authFetch(`/areas?start=1&count=${panelMaxAreas}`);
const aData = await aRes.json();
if (aData.items) {
aData.items.forEach(updateArea);
console.log(`Loaded ${aData.items.length} areas`);
}

updateStatus(true);
updateLastUpdate();
console.log('STEP 3 complete - initial data loaded sequentially');

// Safety reconcile: poll the full zone/area state every 2s from the moment the
// page loads, independent of the WebSocket. The firmware already polls the panel,
// so this guarantees the display tracks it within 2s even if a live WS delta is
// missed (dropped frame, reconnect, throttle edge) or before the WS has connected.
refreshPower();
refreshPanelStatus();
setInterval(async () => { await refreshZones(); await refreshAreas(); await refreshPower(); await refreshPanelStatus(); }, 2000);

// STEP 4: Connect WebSocket with 5-second delay (ensures all initial connections are closed)
console.log('STEP 4: Waiting 5 seconds before WebSocket connection...');
await new Promise(resolve => setTimeout(resolve, 5000));
console.log('STEP 4: Starting WebSocket connection...');
if (useWebSocket) { connectWebSocket(); } else { pollInterval = setInterval(httpPoll, 2000); }
console.log('STEP 4 complete');
})();

function updateArea(areaData) {
const areaEl = areas[areaData.id];
if (!areaEl) return;
const state = areaData.state || '-';
const header = areaEl.querySelector('.area-header');
if (header) header.textContent = `A${String(areaData.id).padStart(2, '0')}-${state}`;
areaEl.title = areaData.name || `Partition ${areaData.id}`;
const flags = areaData.flags || {};
let colorClass = 'normal';
if (flags.alarm) colorClass = 'alarm';
else if (flags.armed) colorClass = 'armed';
else if (flags.part_armed) colorClass = 'part_armed';
else if (flags.exit) colorClass = 'exit';
else if (flags.entry) colorClass = 'entry';
else if (flags.ready) colorClass = 'ready';
else if (flags.secured) colorClass = 'secured';
else if (state === '-' && !flags.ready) colorClass = 'not-ready';
areaEl.className = `area ${colorClass}`;
}

function updateZone(zoneData) {
const zoneEl = zones[zoneData.id];
if (!zoneEl) return;
const state = zoneData.state || '-';
const stateDiv = zoneEl.querySelector('.zone-state');
if (stateDiv) stateDiv.textContent = `Z${String(zoneData.id).padStart(3, '0')}-${state}`;
const name = zoneData.name || `Zone ${zoneData.id}`;
zoneEl.title = `${name} - Click to toggle omit`;
const flags = zoneData.flags;
let colorClass = 'normal';
let activeFlags = 0;
if (flags.alarm) { colorClass = 'alarm'; activeFlags++; }
else if (flags.tamper) { colorClass = 'tamper'; activeFlags++; }
else if (flags.fault) { colorClass = 'fault'; activeFlags++; }
else if (flags.active) { colorClass = 'active'; activeFlags++; }
if (flags.bypassed) activeFlags++;
if (flags.masked) activeFlags++;
if (activeFlags > 1) colorClass = 'multiple';
else if (flags.bypassed && !flags.alarm && !flags.tamper && !flags.fault && !flags.active) colorClass = 'bypassed';
else if (flags.masked && !flags.alarm && !flags.tamper && !flags.fault && !flags.active) colorClass = 'masked';
zoneEl.className = `zone ${colorClass}`;
}

function updateStatus(connected) {
// 'connected' = gateway (WS/HTTP) reachable. The badge shows the PANEL status (set by
// refreshPanelStatus via /healthz); only force DISCONNECTED when the gateway is unreachable.
if (!connected) { connectionStatus.className = 'status-badge badge-disconnected'; connectionStatus.textContent = 'DISCONNECTED'; }
}

function updateLastUpdate() {
const now = new Date();
lastUpdateEl.textContent = `Last Update: ${now.toLocaleTimeString()}`;
}

// Explicitly re-fetch state after an action so the UI updates even if the live
// WebSocket push is missed/coalesced (mirrors the Partitions UI). Two pulls catch
// both the immediate set and any short settle (exit->armed) afterwards.
async function refreshAreas() {
try {
const aRes = await authFetch(`/areas?start=1&count=${panelMaxAreas}`);
const aData = await aRes.json();
if (aData.items) aData.items.forEach(updateArea);
updateLastUpdate();
} catch (e) { console.error('refreshAreas error:', e); }
}
async function refreshZones() {
try {
const zRes = await authFetch(`/zones?start=1&count=${panelMaxZones}`);
const zData = await zRes.json();
if (zData.items) zData.items.forEach(updateZone);
updateLastUpdate();
} catch (e) { console.error('refreshZones error:', e); }
}
function refreshAreasSoon() { setTimeout(refreshAreas, 500); setTimeout(refreshAreas, 1500); }
function refreshAfterOmit() { const f = () => { refreshZones(); refreshAreas(); }; setTimeout(f, 500); setTimeout(f, 1500); }

function armArea(areaId, partArm) {
const action = partArm ? 'PART-ARM' : 'FULL-ARM';
if (confirm(`${action} Partition ${areaId}?`)) {
const endpoint = partArm ? '/areas/part-arm' : '/areas/arm';
authFetch(`${endpoint}?id=${areaId}`, { method: 'POST' })
.then(res => res.json())
.then(data => {
if (data.ok) {
console.log(`Partition ${areaId} ${action} successful`);
refreshAreasSoon();
} else {
alert(`Failed to ${action} area ${areaId}: ${data.error || 'Unknown error'}`);
}
})
.catch(err => alert(`Error: ${err.message}`));
}
}
function disarmArea(areaId) {
if (confirm(`DISARM Partition ${areaId}?`)) {
authFetch(`/areas/disarm?id=${areaId}`, { method: 'POST' })
.then(res => res.json())
.then(data => {
if (data.ok) {
console.log(`Partition ${areaId} DISARM successful`);
refreshAreasSoon();
} else {
alert(`Failed to DISARM area ${areaId}: ${data.error || 'Unknown error'}`);
}
})
.catch(err => alert(`Error: ${err.message}`));
}
}
function resetArea(areaId) {
if (confirm(`RESET Partition ${areaId}? This will clear alarms.`)) {
authFetch(`/areas/reset?id=${areaId}`, { method: 'POST' })
.then(res => res.json())
.then(data => {
if (data.ok) {
console.log(`Partition ${areaId} RESET successful`);
refreshAreasSoon();
} else {
alert(`Failed to RESET area ${areaId}: ${data.error || 'Unknown error'}`);
}
})
.catch(err => alert(`Error: ${err.message}`));
}
}
function toggleOmitZone(zoneId) {
const zoneEl = zones[zoneId];
const isBypassed = zoneEl.className.includes('bypassed');
const actionText = isBypassed ? 'UN-OMIT' : 'OMIT';
if (confirm(`${actionText} Zone ${zoneId}?`)) {
authFetch(`/zones/omit?id=${zoneId}`, { method: 'POST' })
.then(res => res.json())
.then(data => {
if (data.ok) {
console.log(`Zone ${zoneId} ${actionText} successful`);
refreshAfterOmit();
} else {
alert(`Failed to ${actionText} zone ${zoneId}: ${data.error || 'Unknown error'}`);
}
})
.catch(err => alert(`Error: ${err.message}`));
}
}
let ws = null;
let reconnectTimeout = null;
let pollInterval = null;
let globalVer = 0;
let useWebSocket = true;  // Re-enabled with proper delay to prevent TLS handshake collision
async function httpPoll() {
try {
// Poll all zones and areas using actual panel size
// Fetch SEQUENTIALLY to prevent simultaneous TLS handshakes exhausting internal RAM
const zRes = await authFetch(`/zones?start=1&count=${panelMaxZones}`);
const zData = await zRes.json();
const aRes = await authFetch(`/areas?start=1&count=${panelMaxAreas}`);
const aData = await aRes.json();
if (zData.items) zData.items.forEach(updateZone);
if (aData.items) aData.items.forEach(updateArea);
globalVer = Math.max(zData.global_ver || globalVer, aData.global_ver || globalVer);
updateStatus(true);
updateLastUpdate();
} catch (e) { console.error('HTTP poll error:', e); updateStatus(false); }
}
async function httpInit() {
console.log('Initializing HTTP polling mode (SEQUENTIAL)...');
try {
// Fetch SEQUENTIALLY to prevent TLS handshake collisions
const zRes = await authFetch(`/zones?start=1&count=${panelMaxZones}`);
if (!zRes.ok) { throw new Error(`HTTP zones ${zRes.status}`); }
const zData = await zRes.json();

const aRes = await authFetch(`/areas?start=1&count=${panelMaxAreas}`);
if (!aRes.ok) { throw new Error(`HTTP areas ${aRes.status}`); }
const aData = await aRes.json();

console.log('HTTP init received:', (zData.items ? zData.items.length : 0), 'zones,', (aData.items ? aData.items.length : 0), 'areas');
if (zData.items) zData.items.forEach(updateZone);
if (aData.items) aData.items.forEach(updateArea);
globalVer = Math.max(zData.global_ver || 0, aData.global_ver || 0);
updateStatus(true);
updateLastUpdate();
pollInterval = setInterval(httpPoll, 2000);
} catch (e) { console.error('HTTP init error:', e); updateStatus(false); setTimeout(httpInit, 3000); }
}
function connectWebSocket() {
const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
const token = localStorage.getItem('auth_token');
if (!token) { console.error('No auth token, falling back to HTTP'); useWebSocket = false; httpInit(); return; }
const wsUrl = `${protocol}//${window.location.host}/ws?token=${encodeURIComponent(token)}`;
console.log('Connecting to WebSocket with authentication...');
ws = new WebSocket(wsUrl);
let wsConnected = false;
ws.onopen = () => {
console.log('WebSocket connected');
wsConnected = true;
updateStatus(true);
if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
if (reconnectTimeout) { clearTimeout(reconnectTimeout); reconnectTimeout = null; }
};
ws.onmessage = (event) => {
const data = JSON.parse(event.data);
if (data.type === 'init') {
data.zones.forEach(updateZone);
if (data.areas) data.areas.forEach(updateArea);
updateLastUpdate();
} else if (data.type === 'update') {
data.zones.forEach(updateZone);
if (data.areas) data.areas.forEach(updateArea);
updateLastUpdate();
}
};
ws.onerror = (error) => {
console.error('WebSocket error:', error, '- falling back to HTTP polling');
if (!wsConnected) { useWebSocket = false; httpInit(); }
};
ws.onclose = () => {
console.log('WebSocket disconnected');
updateStatus(false);
if (useWebSocket) { reconnectTimeout = setTimeout(connectWebSocket, 3000); } else { httpInit(); }
};
}
async function logout() {
await authFetch('/api/logout', { method: 'POST' }).catch(() => {});
localStorage.clear();
window.location.href = '/ui/login';
}

// Clean up WebSocket connection when page unloads/refreshes
window.addEventListener('beforeunload', () => {
if (ws && ws.readyState === WebSocket.OPEN) {
console.log('Page unloading - closing WebSocket cleanly');
ws.close(1000, 'Page refresh');  // 1000 = normal closure
}
if (pollInterval) {
clearInterval(pollInterval);
}
});
</script>
</div>
</div>
<script src="/ui/theme.js"></script>
</body>
</html>
